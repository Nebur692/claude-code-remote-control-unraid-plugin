<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
  <!ENTITY name      "claude-code">
  <!ENTITY author    "brianpugh">
  <!ENTITY version   "2026.03.06">
  <!ENTITY github    "brianpugh/unraid-claude-code">
  <!ENTITY gitURL    "https://raw.githubusercontent.com/&github;/main">
  <!ENTITY pluginURL "&gitURL;/claude-code.plg">
  <!ENTITY launch    "Settings/ClaudeCode">
  <!ENTITY pkg       "&name;-&version;-noarch-1.txz">
  <!ENTITY sha256    "PENDING">
]>

<PLUGIN name="&name;" author="&author;" version="&version;"
        pluginURL="&pluginURL;"
        launch="&launch;"
        supportURL="https://forums.unraid.net/topic/197615-plugin-claude-code/"
        icon="&gitURL;/claude-icon.png"
        min="6.12.0">

<CHANGES>
###&version;
- Refactored to Slackware package (.txz) convention
- Replaced rc.d polling with disks_mounted event hook
- Added logrotate for install log
- Added Update button to web UI

###2026.03.06
- Initial release
- Installs Claude Code CLI
- Persistent authentication via user-configurable appdata folder
</CHANGES>

<DESCRIPTION>
Claude Code CLI - AI-powered coding assistant from Anthropic.
Use Claude directly in your terminal for code generation, debugging, and more.
</DESCRIPTION>

<!-- Configuration file (only created if not exists, to preserve user settings across reinstalls) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
if [ ! -f /boot/config/plugins/claude-code/claude-code.cfg ]; then
    mkdir -p /boot/config/plugins/claude-code
    echo 'APPDATA_PATH=""' > /boot/config/plugins/claude-code/claude-code.cfg
fi
]]>
</INLINE>
</FILE>

<!-- Download and install the Slackware package -->
<FILE Name="/boot/config/plugins/&name;/&pkg;" Min="6.12.0">
<URL>https://github.com/&github;/releases/download/v&version;/&pkg;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- Install package and handle migration -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# ---- Migration from pre-package version ----
# Remove /boot/config/go entries for old rc.d script
if grep -q "rc.claude-code" /boot/config/go 2>/dev/null; then
    echo "Migrating: removing old /boot/config/go entries..."
    sed -i '/# Start Claude Code/d' /boot/config/go
    sed -i '/rc.claude-code/d' /boot/config/go
    # Clean up any resulting blank lines at end of file
    sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' /boot/config/go
fi

# Remove old rc.d script
if [ -f /etc/rc.d/rc.claude-code ]; then
    echo "Migrating: removing old rc.d script..."
    rm -f /etc/rc.d/rc.claude-code
fi

# Remove old icons subdirectory (now icon is at plugin root)
rm -rf /usr/local/emhttp/plugins/claude-code/icons 2>/dev/null || true

# ---- Clean up old package versions from flash ----
rm -f $(ls /boot/config/plugins/claude-code/claude-code-*.txz 2>/dev/null | grep -v '&pkg;') 2>/dev/null || true

# ---- Install package ----
upgradepkg --install-new /boot/config/plugins/claude-code/&pkg;

# Run install script now (first-time install or plugin update)
LOGFILE="/var/log/claude-code-install.log"
echo "=== Claude Code plugin install $(date) ===" > "$LOGFILE"
/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh >> "$LOGFILE" 2>&1

echo ""
echo "-----------------------------------------------------------"
echo " Claude Code plugin v&version; has been installed!"
echo ""
echo " To use: Open terminal and run: claude"
echo " Web UI: Settings -> Utilities -> Claude Code"
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- Removal -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
echo "Removing Claude Code plugin..."

# Remove Claude Code binary (native install locations)
rm -f /root/.local/bin/claude 2>/dev/null || true
rm -f /usr/local/bin/claude 2>/dev/null || true
CLAUDE_REAL_DIR=$(readlink -f /root/.claude 2>/dev/null || echo "/root/.claude")
rm -rf "$CLAUDE_REAL_DIR/local" 2>/dev/null || true

# Remove config symlink
rm -f /root/.claude 2>/dev/null || true

# Remove the Slackware package
removepkg claude-code 2>/dev/null || true

# Clean up any leftover plugin files
rm -rf /usr/local/emhttp/plugins/claude-code 2>/dev/null || true

# Remove cached package from flash
rm -f /boot/config/plugins/claude-code/claude-code-*.txz 2>/dev/null || true

# Note: We keep config and appdata for potential reinstall
echo ""
echo "Claude Code removed."
echo "Config preserved at: /boot/config/plugins/claude-code/"
echo "Auth data preserved at your appdata location."
echo "Delete manually if you want a complete removal."
]]>
</INLINE>
</FILE>

</PLUGIN>
