<!-- Tab titles live in the page headers, which are plain text with no PHP,
     so the inline t() helper cannot reach them. Unraid loads
     languages/LOCALE/SEGMENT.txt for each segment of the request URI, and
     this page sits under a segment named claude-code. -->
<FILE Name="/usr/local/emhttp/languages/es_ES/claude-code.txt" Mode="0644">
<SHA256>b35c281668848cd4b2531c77c1b6f9e5f0ef8d39fe3340fa370ad9da7d31112c</SHA256>
<INLINE>
<![CDATA[
Dashboard=Panel
Accounts=Cuentas
Remote Control=Control Remoto
Claude Code Config=Config. de Claude
Settings=Ajustes
]]>
</INLINE>
</FILE>

<!-- rc.d startup script (runs on boot via Unraid's init system) -->
<FILE Name="/etc/rc.d/rc.claude-code" Mode="0755">
<SHA256>7eec70b77833d052a834c5c241972955e63b255c0eaf302e13511b2d77c94bbd</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash

# Claude Code startup script for Unraid
# Called by Unraid's init system on boot

LOGFILE="/var/log/claude-code-install.log"
INSTALL_SCRIPT="/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh"

wait_for_network() {
    local max_wait=120
    local waited=0
    echo "Waiting for network..."
    while [ $waited -lt $max_wait ]; do
        # Check if we can reach a reliable host
        if ping -c 1 -W 2 8.8.8.8 &>/dev/null || ping -c 1 -W 2 1.1.1.1 &>/dev/null; then
            echo "Network is available."
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
        echo "Waiting for network... (${waited}s/${max_wait}s)"
    done
    echo "WARNING: Network not available after ${max_wait}s"
    return 1
}

wait_for_array() {
    local max_wait=300
    local waited=0
    echo "Waiting for array..."
    while [ $waited -lt $max_wait ]; do
        if mountpoint -q /mnt/user 2>/dev/null; then
            echo "Array is available."
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
        echo "Waiting for array... (${waited}s/${max_wait}s)"
    done
    echo "WARNING: Array not available after ${max_wait}s"
    return 1
}

do_install() {
    echo "=== Claude Code Startup $(date) ===" > "$LOGFILE"

    # Wait for dependencies
    wait_for_network >> "$LOGFILE" 2>&1
    wait_for_array >> "$LOGFILE" 2>&1

    # Run the actual install
    "$INSTALL_SCRIPT" >> "$LOGFILE" 2>&1
}

case "$1" in
    start)
        echo "Starting Claude Code..."
        # Run in background to not block boot
        nohup "$0" _run > /dev/null 2>&1 &
        ;;
    _run)
        export PATH="/root/.local/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
        export HOME='/root'
        do_install
        ;;
    stop)
        echo "Stopping Claude Code..."
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
]]>
</INLINE>
</FILE>

<!-- Post-install -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Add startup entry to go file if not already present
GO_FILE="/boot/config/go"
STARTUP_CMD="/etc/rc.d/rc.claude-code start"

if ! grep -q "rc.claude-code" "$GO_FILE" 2>/dev/null; then
    echo "" >> "$GO_FILE"
    echo "# Start Claude Code" >> "$GO_FILE"
    echo "$STARTUP_CMD" >> "$GO_FILE"

    # Run install now (only on first-time plugin install, not on boot)
    /usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh

    echo ""
    echo "-----------------------------------------------------------"
    echo " Claude Code plugin v2026.09.04.2 has been installed!"
    echo ""
    echo " To use: Open terminal and run: claude"
    echo " Web UI: Settings -> Utilities -> Claude Code"
    echo "-----------------------------------------------------------"
    echo ""
fi

# Every install and update, not just the first one: keeps /usr/local/bin/claude
# pointing at the current launcher so a new version takes effect without
# waiting for a reboot.
/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh launcher

# Unraid parses a translation file once and caches the result beside it,
# rebuilding that cache only when it is missing. Without this, a version that
# changes the tab titles would keep showing the previous ones until a reboot.
rm -f /usr/local/emhttp/languages/*/claude-code.dot
]]>
</INLINE>
</FILE>

<!-- Removal -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
echo "Removing Claude Code plugin..."

# Stop Remote Control *first*, while the script that knows how to do it still
# exists. Skipping this used to leave the supervisor running as an orphan: it
# respawns "claude remote-control" every 5s and its stop path had just been
# deleted along with the plugin, so only a reboot got rid of it.
RC_SCRIPT="/usr/local/emhttp/plugins/claude-code/scripts/remote-control.sh"
if [ -x "$RC_SCRIPT" ]; then
    "$RC_SCRIPT" stop 2>/dev/null || true
fi
# Same teardown inline, in case the plugin tree was already gone (a failed or
# repeated removal) and the branch above never ran. All of these live in
# /var/run -- nothing here touches config or appdata.
rm -f /var/run/claude-remote-control.enabled /var/run/claude-remote-control.pin
if [ -f /var/run/claude-remote-control.pid ]; then
    kill "$(cat /var/run/claude-remote-control.pid)" 2>/dev/null || true
    rm -f /var/run/claude-remote-control.pid
fi
# The supervisor runs as "bash .../remote-control.sh _run" and forks subshells
# and a session watcher under it, none of which the pidfile covers.
pkill -f "remote-control.sh _run" 2>/dev/null || true
pkill -f "claude remote-control" 2>/dev/null || true

# Remove startup entry from go file
sed -i '/# Start Claude Code/d' /boot/config/go 2>/dev/null || true
sed -i '/rc.claude-code/d' /boot/config/go 2>/dev/null || true

# Remove rc.d script
rm -f /etc/rc.d/rc.claude-code

# Remove Claude Code binary (native install locations)
rm -rf /root/.local/bin/claude 2>/dev/null || true
CLAUDE_REAL_DIR=$(readlink -f /root/.claude 2>/dev/null || echo "/root/.claude")
rm -rf "$CLAUDE_REAL_DIR/local" 2>/dev/null || true

# Remove config symlink
rm -f /root/.claude 2>/dev/null || true

# Remove plugin runtime files
rm -rf /usr/local/emhttp/plugins/claude-code
# The tab titles are translated through a file this plugin drops into Unraid's
# own language directory, along with the parsed copy Unraid caches beside it.
rm -f /usr/local/emhttp/languages/*/claude-code.txt
rm -f /usr/local/emhttp/languages/*/claude-code.dot
rm -f /usr/local/bin/claude
rm -f /var/tmp/claude-code-stats-sample.json
# Cached figures, including the one file per account the usage panel writes.
rm -f /var/tmp/claude-code-usage-cache*.json
# Last known plan figures and the subscription details behind them.
rm -f /var/tmp/claude-code-usage-last-*.json /var/tmp/claude-code-profile-*.json
rm -f /var/tmp/claude-login-*.log /var/tmp/claude-login-*.fifo

# Note: We keep config and appdata for potential reinstall
echo ""
echo "Claude Code removed."
echo "Config preserved at: /boot/config/plugins/claude-code/"
echo "Auth data preserved at your appdata location."
echo "Delete manually if you want a complete removal."
]]>
</INLINE>
</FILE>

</PLUGIN>
