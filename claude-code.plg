<FILE Name="/usr/local/emhttp/plugins/claude-code/ClaudeCodeDashboard.page">
<SHA256>554457b2146d1b93d07d0b0bfc44b5287c0dcfe229b6bcc73521a3f7609e7ad2</SHA256>
<INLINE>
<![CDATA[
Menu="claude-code:1"
Title="Dashboard"
Tag="dashboard"
---
<?php require_once "/usr/local/emhttp/plugins/claude-code/include/common.php"; ?>
<p><?=t('Claude Code CLI for Unraid - AI-powered coding assistant in your terminal.', 'Claude Code CLI para Unraid - asistente de programación con IA en tu terminal.')?></p>

<div class="claude-status">
<b><?=t('Status:', 'Estado:')?></b>
Claude Code: <span class="<?=$claude_installed ? 'ok' : 'error'?>"><?=$claude_installed ? $claude_version : t('Not installed', 'No instalado')?></span>
<span class="sep">&middot;</span>
<?=t('Array', 'Array')?>: <span class="<?=$array_started ? 'ok' : 'error'?>"><?=$array_started ? t('Started', 'Iniciado') : t('Not started', 'No iniciado')?></span>
<span class="sep">&middot;</span>
Symlink: <span class="<?=$symlink_ok ? 'ok' : 'warn'?>"><?=$symlink_ok ? 'OK' : t('Not configured', 'No configurado')?></span>
<span class="sep">&middot;</span>
<!-- Filled in by the poller defined with the Resource usage box further down.
     The headline figures live up here so they are visible without scrolling;
     the per-process breakdown stays in that box. -->
<span id="claude-stats-bar"><span class="dim-text"><?=t('measuring...', 'midiendo...')?></span></span>
</div>

<!-- Claude.ai plan usage, on its own line under the status bar: the 5-hour and
     weekly windows with the date each one resets, any per-model window and
     credit balance the plan reports, and when the subscription renews.
     A server logged in with an API key has no plan windows and no reading
     ever succeeded for it, so it says so plainly instead of showing an error
     nobody can act on. Once a reading has succeeded the figures stay on the
     line even when the account has been idle too long to refresh them, with
     the time they were taken. -->
<!-- One line per account. Plan limits belong to an account, so even with a
     single account the figures are labelled with whose they are; with several
     there is no meaningful combined number to show. -->
<div id="claude-usage-accounts"></div>

<script>
(function () {
  var L = <?=json_encode([
      'five_hour' => t('5h limit', 'Límite 5 h'),
      'seven_day' => t('Weekly', 'Semanal'),
      'resets'    => t('resets in', 'reset en'),
      'balance'   => t('Credit', 'Saldo'),
      'spent'     => t('Spent', 'Gastado'),
      'expired'   => t('usage data expired - refreshes next time Claude runs',
                       'datos caducados - se actualizan la próxima vez que se use Claude'),
      'day'       => t('d', 'd'),
      'hour'      => t('h', 'h'),
      'min'       => t('min', 'min'),
      'nodata'    => t('not signed in', 'sin iniciar sesión'),
      'plan'      => t('Plan usage', 'Uso del plan'),
      // Shown with the figures whenever they are the last reading rather than
      // a current one, so a number on this line is never mistaken for live.
      'last'      => t('last reading', 'última lectura'),
      'sub'       => t('Subscription', 'Suscripción'),
      'renews'    => t('renews', 'renueva'),
      'trial'     => t('trial ends', 'prueba acaba'),
      // The states Stripe reports for a Claude subscription. Anything else is
      // shown exactly as the API worded it rather than guessed at.
      'status'    => [
          'active'     => t('active', 'activa'),
          'trialing'   => t('trial', 'en prueba'),
          'past_due'   => t('payment overdue', 'pago pendiente'),
          'canceled'   => t('cancelled', 'cancelada'),
          'cancelled'  => t('cancelled', 'cancelada'),
          'unpaid'     => t('unpaid', 'sin pagar'),
          'incomplete' => t('incomplete', 'incompleta'),
          'paused'     => t('paused', 'en pausa'),
      ],
      'est_help'  => t('Estimated: Anthropic reports when the subscription started and that it is active, not the billing date. This is the monthly anniversary of the start date.',
                       'Estimada: Anthropic informa de cuándo empezó la suscripción y de que está activa, no de la fecha de facturación. Esta es el aniversario mensual de la fecha de alta.'),
      'stale_help'=> t('Claude Code renews its access token while it is in use. After a few idle hours the plan figures can no longer be refreshed, so the last reading is shown with the time it was taken.',
                       'Claude Code renueva su token de acceso mientras se usa. Tras unas horas sin actividad ya no se pueden refrescar las cifras del plan, así que se muestra la última lectura con la hora a la que se tomó.'),
  ])?>;
  // Dates are written the way the webGUI language is set, not the browser's.
  var LOCALE = <?=json_encode($isSpanish ? 'es-ES' : 'en-GB')?>;
  // Model display names come from the API, so escape before injecting them.
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  // Same thresholds the status bar above uses for its own state colours.
  function cls(pct) { return pct >= 90 ? 'error' : (pct >= 75 ? 'warn' : 'ok'); }

  // "resets in 2 d 17 h" reads better than a timestamp you have to subtract
  // from now. Windows with no reset time (an untouched 5-hour window has none)
  // return '' and the caller leaves the parenthetical off.
  function until(ts) {
    if (!ts) return '';
    var s = ts - Math.floor(Date.now() / 1000);
    if (s <= 0) return '';
    var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
    if (d > 0) return d + ' ' + L.day + ' ' + h + ' ' + L.hour;
    if (h > 0) return h + ' ' + L.hour + ' ' + m + ' ' + L.min;
    return m + ' ' + L.min;
  }

  // The countdown says how long you have; the date says when that is, which is
  // what you need to decide whether to wait for it. Both, not one or the other.
  function stamp(ts, withTime) {
    if (!ts) return '';
    var o = withTime === false
      ? { day: 'numeric', month: 'short', year: 'numeric' }
      : { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' };
    try { return new Date(ts * 1000).toLocaleString(LOCALE, o); }
    catch (e) { return new Date(ts * 1000).toLocaleString(); }
  }

  function money(v, cur) { return v.toFixed(2) + ' ' + esc(cur || 'USD'); }

  // Builds the figures for one account. Shared by the single-account bar and by
  // the per-account rows, so both always say the same thing the same way.
  function usageParts(d) {
    var parts = [];
    for (var i = 0; i < (d.windows || []).length; i++) {
      var w = d.windows[i];
      var name = w.key === 'five_hour' ? L.five_hour
               : (w.key === 'model' ? L.seven_day + ' (' + w.label + ')' : L.seven_day);
      var rel = until(w.resets_at);
      var abs = stamp(w.resets_at);
      parts.push('<b>' + esc(name) + ':</b> ' +
                 '<span class="' + cls(w.percent) + '">' + Math.round(w.percent) + '%</span>' +
                 (rel ? ' <span class="dim-text">(' + esc(L.resets) + ' ' + esc(rel) +
                        (abs ? ' &mdash; ' + esc(abs) : '') + ')</span>' : ''));
    }
    // Only present when the account actually has extra usage enabled.
    if (d.spend) {
      if (d.spend.balance !== null) parts.push('<b>' + esc(L.balance) + ':</b> ' + money(d.spend.balance, d.spend.currency));
      if (d.spend.used !== null) parts.push('<b>' + esc(L.spent) + ':</b> ' + money(d.spend.used, d.spend.currency));
    }
    // When the subscription renews. Anthropic reports the start date and the
    // status, never the billing date, so the renewal is the monthly
    // anniversary and is marked with a "~" and an explanation on hover.
    var s = d.subscription;
    if (s && (s.status || s.renews)) {
      var bits = [];
      if (s.status) {
        var good = (s.status === 'active' || s.status === 'trialing');
        bits.push('<span class="' + (good ? 'ok' : 'warn') + '">' +
                  esc(L.status[s.status] || s.status) + '</span>');
      }
      if (s.renews) bits.push('<span title="' + esc(L.est_help) + '">' + esc(L.renews) + ' ~' + esc(stamp(s.renews, false)) + '</span>');
      if (s.trial_ends) bits.push('<span class="warn">' + esc(L.trial) + ' ' + esc(stamp(s.trial_ends, false)) + '</span>');
      parts.push('<b>' + esc(L.sub) + ':</b> ' + bits.join(' '));
    }
    return parts.join('<span class="sep">&middot;</span>');
  }

  // The accounts to report on. With one account this is empty and everything
  // below behaves exactly as it did before the feature existed.
  var ACCOUNTS = <?=json_encode($usage_accounts)?>;

  var wrapAccounts = document.getElementById('claude-usage-accounts');

  function rowFor(slug) {
    var id = 'claude-usage-acct-' + slug;
    var row = document.getElementById(id);
    if (!row) {
      row = document.createElement('div');
      row.id = id;
      row.className = 'claude-status';
      wrapAccounts.appendChild(row);
    }
    return row;
  }

  function renderAccount(acct, d) {
    var row = rowFor(acct.slug);
    var who = '<b>' + esc(L.plan) + '</b> <span class="sep">&middot;</span> <span class="ok">' + esc(acct.label) + '</span>: ';
    if (!d || (d.state !== 'ok' && !(d.windows && d.windows.length))) {
      // Nothing was ever read for this account, so there is genuinely nothing
      // to show: say why rather than leaving a gap the reader has to interpret.
      var why = d && d.state === 'expired' ? L.expired : L.nodata;
      row.innerHTML = who + '<span class="dim-text">' + esc(why) + '</span>';
      return;
    }
    var figures = usageParts(d);
    // An account that has been idle for hours can no longer refresh its token,
    // and the figures then stop moving. Rather than blanking the line, show the
    // last reading and say when it was taken.
    var age = '';
    if (d.state !== 'ok' || d.stale) {
      age = '<span class="sep">&middot;</span><span class="warn" title="' + esc(L.stale_help) + '">' +
            esc(L.last) + ': ' + esc(stamp(d.measured_at)) + '</span>';
    }
    row.innerHTML = who + (figures || '<span class="dim-text">' + esc(L.nodata) + '</span>') + age;
  }

  function pollAccounts() {
    ACCOUNTS.forEach(function (acct) {
      fetch('/plugins/claude-code/include/claude-usage.php?profile=' + encodeURIComponent(acct.slug), { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (d) { renderAccount(acct, d); })
        .catch(function () { renderAccount(acct, null); });
    });
  }

  var timer = null;
  function poll() { pollAccounts(); }
  function start() { if (!timer) { poll(); timer = setInterval(poll, 60000); } }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  start();
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop(); else start();
  });
})();
</script>

<div class="claude-box">
<h4><?=t('Resource usage', 'Consumo de recursos')?></h4>
<p><?=t(
    'Live CPU and memory used by Claude Code on this server: the Remote Control bridge, the session worker it starts, and any interactive claude you are running in a terminal. Refreshes every few seconds while this page is open. The totals are in the status bar at the top of this page; the breakdown per process is below.',
    'CPU y memoria que consume Claude Code en este servidor en tiempo real: el puente de Control Remoto, el proceso de sesión que lanza, y cualquier claude interactivo que tengas abierto en una terminal. Se actualiza cada pocos segundos mientras esta página esté abierta. Los totales están en la barra de estado arriba del todo; aquí abajo tienes el desglose por proceso.'
)?></p>

<p id="claude-stats-idle" style="display:none;" class="dim-text"><?=t('Claude Code is not running.', 'Claude Code no está corriendo.')?></p>

<table class="claude-history" id="claude-stats-table" style="display:none;">
<thead><tr><th>PID</th><th>CPU</th><th>RAM</th><th><?=t('Process', 'Proceso')?></th></tr></thead>
<tbody></tbody>
</table>

<blockquote class="inline_help"><?=t(
    'CPU is measured between refreshes and expressed as a percentage of a single core, so it can go above 100% on this multi-core server. Memory is the resident set added up across processes, which counts shared pages more than once and so reads slightly high.',
    'La CPU se mide entre actualizaciones y se expresa como porcentaje de un solo núcleo, así que puede pasar del 100% en este servidor multinúcleo. La memoria es la suma del resident set de cada proceso, que cuenta más de una vez las páginas compartidas, así que queda algo por encima de la real.'
)?></blockquote>

<script>
(function () {
  var L = <?=json_encode([
      'idle'      => t('Claude Code is not running', 'Claude Code no está corriendo'),
      'measuring' => t('measuring...', 'midiendo...'),
      'error'     => t('Could not read resource usage', 'No se pudo leer el consumo de recursos'),
      'cpu'       => t('CPU', 'CPU'),
      'ram'       => t('RAM', 'RAM'),
      'procs'     => t('Processes', 'Procesos'),
      'cores'     => t('cores', 'núcleos'),
  ])?>;
  // The totals render into the page's top status bar; only the per-process
  // table and its "nothing running" placeholder live in this box.
  var bar = document.getElementById('claude-stats-bar');
  var idle = document.getElementById('claude-stats-idle');
  var table = document.getElementById('claude-stats-table');
  var tbody = table.getElementsByTagName('tbody')[0];

  function mem(kb) {
    if (kb >= 1048576) return (kb / 1048576).toFixed(2) + ' GB';
    if (kb >= 1024) return (kb / 1024).toFixed(0) + ' MB';
    return kb + ' KB';
  }
  // Command lines come straight from /proc, so escape before injecting them.
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function render(d) {
    if (!d.count) {
      bar.innerHTML = '<span class="warn">' + esc(L.idle) + '</span>';
      table.style.display = 'none';
      idle.style.display = '';
      return;
    }
    idle.style.display = 'none';
    // The very first poll has no earlier sample to diff against, so there is
    // no CPU figure to show yet -- only from the second poll onwards.
    var cpu = d.have_delta ? d.cpu_pct.toFixed(1) + '%' : L.measuring;
    bar.innerHTML =
      '<b>' + esc(L.cpu) + ':</b> <span class="ok">' + esc(cpu) + '</span>' +
      '<span class="sep">&middot;</span><b>' + esc(L.ram) + ':</b> <span class="ok">' + mem(d.rss_kb) +
      (d.rss_pct !== null ? ' (' + d.rss_pct + '%)' : '') + '</span>' +
      '<span class="sep">&middot;</span><b>' + esc(L.procs) + ':</b> <span class="ok">' + d.count + '</span>' +
      '<span class="sep">&middot;</span><span class="dim-text">' + d.cores + ' ' + esc(L.cores) + '</span>';

    var rows = '';
    for (var i = 0; i < d.procs.length; i++) {
      var p = d.procs[i];
      var c = (p.cpu_pct === null || p.cpu_pct === undefined) ? '-' : p.cpu_pct.toFixed(1) + '%';
      var cmd = p.cmd.length > 90 ? p.cmd.slice(0, 90) + '...' : p.cmd;
      rows += '<tr><td>' + p.pid + '</td><td>' + c + '</td><td>' + mem(p.rss_kb) +
              '</td><td><code>' + esc(cmd) + '</code></td></tr>';
    }
    tbody.innerHTML = rows;
    table.style.display = '';
  }

  var timer = null;
  function poll() {
    fetch('/plugins/claude-code/include/claude-stats.php', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(render)
      .catch(function () { bar.innerHTML = '<span class="warn">' + esc(L.error) + '</span>'; });
  }
  function start() { if (!timer) { poll(); timer = setInterval(poll, 3000); } }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  start();
  // Don't keep polling every 3s forever in a background tab nobody is looking at.
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stop(); else start();
  });
})();
</script>
</div>

<div class="claude-box">
<h4><?=t('Usage', 'Uso')?></h4>
<p><?=t('Open the Unraid terminal (top-right corner) and run:', 'Abre la terminal de Unraid (esquina superior derecha) y ejecuta:')?></p>
<code class="claude-code-block">claude</code>
</div>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/claude-code/ClaudeCodeAccounts.page">
<SHA256>1f7c736dc438879d66857177c533f23428f92e80f2a3993eaf0c969f0cb01fcf</SHA256>
<INLINE>
<![CDATA[
Menu="claude-code:2"
Title="Accounts"
Tag="users"
---
<?php require_once "/usr/local/emhttp/plugins/claude-code/include/common.php"; ?>
<div class="claude-box">
<h4><?=t('Claude accounts', 'Cuentas de Claude')?></h4>
<p><?=t(
    'Lets this server hold more than one Claude login and choose which one it uses. Everything stays on this server: each account keeps its own credentials in a separate folder inside your appdata, and the account you pick here is the one used by Remote Control and by "claude" in the terminal.',
    'Permite que este servidor tenga más de una sesión de Claude iniciada y elegir cuál usa. Todo se queda en este servidor: cada cuenta guarda sus credenciales en una carpeta aparte dentro de tu appdata, y la cuenta que elijas aquí es la que usan el Control Remoto y el comando "claude" de la terminal.'
)?></p>

<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$cfg_file?>">
<dl>
<dt><?=t('Several accounts:', 'Varias cuentas:')?></dt>
<dd>
<!-- The hidden field is what makes an unticked box mean "no": an unchecked
     checkbox posts nothing at all, so without it turning the feature off would
     simply leave the old value in place. -->
<input type="hidden" name="MULTI_ACCOUNT" value="no">
<label><input type="checkbox" name="MULTI_ACCOUNT" value="yes"<?=$multi_account ? ' checked' : ''?>> <?=t('Enabled', 'Habilitado')?></label>
</dd>
</dl>
<dl>
<dt><?=t('Memory and settings:', 'Memoria y ajustes:')?></dt>
<dd>
<select name="ACCOUNT_MODE"<?=$mode_locked ? ' disabled' : ''?>>
<option value="shared"<?=$account_mode === 'shared' ? ' selected' : ''?>><?=t('Shared between accounts', 'Compartidos entre cuentas')?></option>
<option value="isolated"<?=$account_mode === 'isolated' ? ' selected' : ''?>><?=t('Separate for each account', 'Separados para cada cuenta')?></option>
</select>
</dd>
</dl>
<blockquote class="inline_help"><?=t(
    'Shared is the usual choice: every account works with the same agent memory, settings and MCP servers, and only the login itself changes. Separate gives each account its own memory, settings and history, which start out empty. Both let several accounts be used at the same time.',
    'Compartidos es lo habitual: todas las cuentas trabajan con la misma memoria del agente, los mismos ajustes y los mismos servidores MCP, y lo único que cambia es la sesión iniciada. Separados le da a cada cuenta su propia memoria, ajustes e historial, que empiezan vacíos. En ambos casos se pueden usar varias cuentas a la vez.'
)?></blockquote>
<?php if ($mode_locked): ?>
<blockquote class="inline_help"><span class="dim-text"><?=t(
    'This cannot be changed while more than one account exists, because it decides where each account keeps its files. Remove the extra accounts first.',
    'Esto no se puede cambiar mientras exista más de una cuenta, porque decide dónde guarda sus ficheros cada una. Elimina antes las cuentas adicionales.'
)?></span></blockquote>
<?php endif; ?>
<input type="submit" value="<?=t('Apply', 'Aplicar')?>">
</form>

<?php if ($multi_account): ?>
<dl>
<dt><?=t('Accounts:', 'Cuentas:')?></dt>
<dd>
<table class="claude-history">
<tr>
<th><?=t('Name', 'Nombre')?></th>
<th><?=t('Signed in as', 'Sesión iniciada como')?></th>
<th><?=t('Plan', 'Plan')?></th>
<th><?=t('In use', 'En uso')?></th>
<th></th>
</tr>
<?php foreach ($profiles as $p): ?>
<tr>
<td><?=htmlspecialchars($p['label'])?><?php if ($p['slug'] !== $p['label']): ?> <span class="dim-text">(<?=htmlspecialchars($p['slug'])?>)</span><?php endif; ?></td>
<td><?php if ($p['logged']): ?><?=htmlspecialchars($p['email'])?><?php else: ?><span class="warn"><?=t('Not signed in', 'Sin iniciar sesión')?></span><?php endif; ?></td>
<td><?=$p['plan'] !== '' ? htmlspecialchars(ucfirst($p['plan'])) : '&mdash;'?></td>
<td><?php if ($p['active']): ?><span class="ok"><?=t('Yes', 'Sí')?></span><?php else: ?><span class="dim-text"><?=t('No', 'No')?></span><?php endif; ?></td>
<td>
<input type="button" value="<?=$p['logged'] ? t('Sign in again', 'Volver a iniciar sesión') : t('Sign in', 'Iniciar sesión')?>"
       onclick="claudeLoginStart('<?=htmlspecialchars($p['slug'], ENT_QUOTES)?>','<?=htmlspecialchars($p['label'], ENT_QUOTES)?>');">
<?php if (!$p['active']): ?>
<input type="button" value="<?=t('Use this one', 'Usar esta')?>"
       onclick="claudeAccount('activate','<?=htmlspecialchars($p['slug'], ENT_QUOTES)?>');">
<?php endif; ?>
<?php if ($p['slug'] !== 'default' && !$p['active']): ?>
<input type="button" value="<?=t('Remove', 'Eliminar')?>"
       onclick="claudeAccount('remove','<?=htmlspecialchars($p['slug'], ENT_QUOTES)?>');">
<?php endif; ?>
</td>
</tr>
<?php endforeach; ?>
</table>
</dd>
</dl>
<blockquote class="inline_help"><?=t(
    'Removing an account only takes it off this list; its folder inside appdata is left alone, so nothing is lost by accident. Switching accounts restarts Remote Control if it is running, and terminals you already have open keep the previous account until you start a new one.',
    'Eliminar una cuenta solo la quita de esta lista; su carpeta dentro de appdata se deja intacta, así que no se pierde nada por accidente. Cambiar de cuenta reinicia el Control Remoto si está corriendo, y las terminales que ya tengas abiertas siguen con la cuenta anterior hasta que abras una nueva.'
)?></blockquote>

<dl>
<dt><?=t('Add an account:', 'Añadir una cuenta:')?></dt>
<dd>
<input type="text" id="claude-account-name" class="narrow" placeholder="<?=t('for example: Work', 'por ejemplo: Trabajo')?>" autocomplete="off">
<input type="button" value="<?=t('Add', 'Añadir')?>" onclick="claudeAccountAdd();">
</dd>
</dl>
<blockquote class="inline_help"><?=t(
    'Call it whatever makes sense to you; the folder that holds it is named automatically. Adding an account does not sign it in yet: use Sign in next to it once it appears in the table.',
    'Llámala como te resulte útil; la carpeta que la guarda se nombra sola. Añadir una cuenta todavía no inicia sesión en ella: usa Iniciar sesión a su lado en cuanto aparezca en la tabla.'
)?></blockquote>

<input type="button" value="<?=t('Refresh account details', 'Actualizar datos de las cuentas')?>" onclick="claudeAccount('refresh','');">
<p id="claude-account-msg"></p>

<script>
(function () {
  var L = <?=json_encode([
      'working' => t('Working...', 'Trabajando...'),
      'network' => t('Could not reach the server.', 'No se pudo contactar con el servidor.'),
      'noname'  => t('Type a name for the account first.', 'Escribe antes un nombre para la cuenta.'),
  ])?>;
  var msg = document.getElementById('claude-account-msg');
  // Unraid rejects every POST to a webGUI PHP file that carries no CSRF token,
  // and terminates the request with an empty body -- which arrives here looking
  // exactly like the server being unreachable. It travels as a form field; the
  // X-CSRF-TOKEN header is equally accepted.
  var CSRF = <?=json_encode($var['csrf_token'] ?? '')?>;

  // Every account action reports here, next to the button that caused it.
  // Posting these to Unraid's progress frame instead put the answer in a
  // one-line strip nobody reads, which turned a plain "that name will not do"
  // into a button that looked broken.
  function send(params, onOk) {
    msg.textContent = L.working;
    msg.className = '';
    var body = new URLSearchParams(params);
    body.set('csrf_token', CSRF);
    fetch('/plugins/claude-code/include/claude-accounts.php',
          { method: 'POST', cache: 'no-store', headers: { 'X-CSRF-TOKEN': CSRF }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        msg.textContent = d.message || '';
        msg.className = d.ok ? 'ok' : 'error';
        if (d.ok) setTimeout(function () { location.reload(); }, 900);
      })
      .catch(function () { msg.textContent = L.network; msg.className = 'error'; });
  }

  window.claudeAccount = function (action, slug) { send({ action: action, slug: slug }); };

  window.claudeAccountAdd = function () {
    var name = document.getElementById('claude-account-name').value.trim();
    if (!name) { msg.textContent = L.noname; msg.className = 'error'; return; }
    send({ action: 'add', name: name });
  };
})();
</script>
<?php endif; ?>
</div>

<?php if (!$multi_account): ?>
<!-- With one account there is no list to manage, but there still has to be a
     way in from the browser: this replaces the old "first-time setup" box that
     told people to open a terminal and run claude. -->
<div class="claude-box">
<h4><?=t('Sign in to Claude', 'Iniciar sesión en Claude')?></h4>
<?php if ($account_email !== ''): ?>
<p><?=t('Signed in as', 'Sesión iniciada como')?> <b><?=htmlspecialchars($account_email)?></b><?=$account_plan !== '' ? ' (' . htmlspecialchars($account_plan) . ')' : ''?>.
<?=t('Signing in again replaces this login with another Claude account.', 'Volver a iniciar sesión sustituye esta sesión por la de otra cuenta de Claude.')?></p>
<?php else: ?>
<p><?=t('This server is not signed in to Claude yet. Signing in takes two steps and happens entirely on this page: open the authorisation page, then paste back the code it gives you.', 'Este servidor todavía no ha iniciado sesión en Claude. Iniciar sesión son dos pasos y ocurre entero en esta página: abre la página de autorización y luego pega aquí el código que te dé.')?></p>
<?php endif; ?>
<input type="button" value="<?=$account_email !== '' ? t('Sign in again', 'Volver a iniciar sesión') : t('Sign in', 'Iniciar sesión')?>"
       onclick="claudeLoginStart('default','<?=htmlspecialchars(t('main account', 'cuenta principal'), ENT_QUOTES)?>');">
</div>
<?php endif; ?>

<!-- Signing in happens here rather than in a terminal. "claude auth login"
     prints an authorisation URL and then waits for a one-time code on its
     standard input, so the endpoint behind this panel starts it detached,
     hands the URL over, and passes the pasted code back to it. -->
<div class="claude-box" id="claude-login-panel" style="display:none;">
<h4><?=t('Signing in', 'Iniciando sesión')?> <span id="claude-login-who" class="dim-text"></span></h4>
<p id="claude-login-step1" style="display:none;">
<?=t('1. Open the authorisation page, sign in with the account you want, and copy the code it gives you.', '1. Abre la página de autorización, inicia sesión con la cuenta que quieras y copia el código que te dé.')?>
<br><a id="claude-login-url" href="#" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> <u><?=t('Open the authorisation page', 'Abrir la página de autorización')?></u></a>
</p>
<div id="claude-login-step2" style="display:none;">
<dl>
<dt><?=t('2. Paste the code:', '2. Pega el código:')?></dt>
<dd>
<input type="text" id="claude-login-code" class="narrow" autocomplete="off" spellcheck="false">
<input type="button" id="claude-login-send" value="<?=t('Sign in', 'Iniciar sesión')?>">
</dd>
</dl>
</div>
<p id="claude-login-msg"></p>
<input type="button" value="<?=t('Cancel', 'Cancelar')?>" onclick="claudeLoginCancel();">
</div>

<script>
(function () {
  var L = <?=json_encode([
      'starting'  => t('Preparing the authorisation link...', 'Preparando el enlace de autorización...'),
      'waiting'   => t('Waiting for the code.', 'Esperando el código.'),
      'sent'      => t('Checking the code...', 'Comprobando el código...'),
      'done'      => t('Signed in. Reloading...', 'Sesión iniciada. Recargando...'),
      'failed'    => t('Sign-in failed:', 'No se pudo iniciar sesión:'),
      'network'   => t('Could not reach the server.', 'No se pudo contactar con el servidor.'),
      'nocode'    => t('Paste the code first.', 'Pega antes el código.'),
      'signing'   => t('for', 'para'),
  ])?>;
  var ENDPOINT = '/plugins/claude-code/include/claude-login.php';
  var CSRF = <?=json_encode($var['csrf_token'] ?? '')?>;
  var slug = null, timer = null;

  function el(id) { return document.getElementById(id); }
  function show(id, on) { el(id).style.display = on ? '' : 'none'; }
  function msg(text) { el('claude-login-msg').textContent = text; }

  function stop() { if (timer) { clearInterval(timer); timer = null; } }

  function render(d) {
    if (d.state === 'url') {
      el('claude-login-url').href = d.url;
      show('claude-login-step1', true);
      show('claude-login-step2', !!d.waiting);
      if (d.waiting) msg(L.waiting);
    } else if (d.state === 'done') {
      stop();
      msg(L.done);
      // The table above is rendered server side, so the finished account only
      // appears after a reload.
      setTimeout(function () { location.reload(); }, 800);
    } else if (d.state === 'failed') {
      stop();
      msg(L.failed + ' ' + (d.error || ''));
      show('claude-login-step2', true);
    } else if (d.state === 'starting') {
      msg(L.starting);
    }
  }

  function poll() {
    fetch(ENDPOINT + '?action=poll&profile=' + encodeURIComponent(slug), { cache: 'no-store' })
      .then(function (r) { return r.json(); }).then(render)
      .catch(function () { msg(L.network); });
  }

  window.claudeLoginStart = function (s, label) {
    slug = s;
    el('claude-login-who').textContent = L.signing + ' ' + label;
    show('claude-login-panel', true);
    show('claude-login-step1', false);
    show('claude-login-step2', false);
    msg(L.starting);
    el('claude-login-code').value = '';
    fetch(ENDPOINT + '?action=start&profile=' + encodeURIComponent(slug), { cache: 'no-store' })
      .then(function () { stop(); poll(); timer = setInterval(poll, 2000); })
      .catch(function () { msg(L.network); });
    el('claude-login-panel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  window.claudeLoginCancel = function () {
    stop();
    if (slug) fetch(ENDPOINT + '?action=cancel&profile=' + encodeURIComponent(slug), { cache: 'no-store' });
    show('claude-login-panel', false);
  };

  el('claude-login-send').addEventListener('click', function () {
    var code = el('claude-login-code').value.trim();
    if (!code) { msg(L.nocode); return; }
    msg(L.sent);
    // Sent as a POST so the one-time code never lands in a URL, a proxy log or
    // the browser's history.
    var body = new URLSearchParams();
    body.set('action', 'code');
    body.set('profile', slug);
    body.set('code', code);
    body.set('csrf_token', CSRF);
    el('claude-login-code').value = '';
    fetch(ENDPOINT, { method: 'POST', cache: 'no-store', headers: { 'X-CSRF-TOKEN': CSRF }, body: body })
      .then(function (r) { return r.json(); })
      .then(function () { poll(); })
      .catch(function () { msg(L.network); });
  });
})();
</script>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/claude-code/ClaudeCodeRemote.page">
<SHA256>2dc7669153639d55a52e0e3a8f1976d610038936b5c8999fc57851de624929a9</SHA256>
<INLINE>
<![CDATA[
Menu="claude-code:3"
Title="Remote Control"
Tag="desktop"
---
<?php require_once "/usr/local/emhttp/plugins/claude-code/include/common.php"; ?>
<div class="claude-box">
<h4><?=t('Remote Control', 'Control Remoto')?></h4>
<p><?=t(
    'Runs "claude remote-control" in the background so you can drive a Claude Code session on this NAS from claude.ai/code or the Claude mobile app -- outbound HTTPS only, no inbound ports opened. Requires being signed in with a claude.ai account (Pro/Max/Team/Enterprise); API key auth does not support this.',
    'Ejecuta "claude remote-control" en segundo plano para que puedas controlar una sesión de Claude Code en este NAS desde claude.ai/code o la app móvil de Claude -- solo conexiones HTTPS salientes, sin abrir puertos entrantes. Requiere haber iniciado sesión con una cuenta de claude.ai (Pro/Max/Team/Enterprise); la autenticación por API key no es compatible.'
)?></p>
<p><?=t(
    'Always resumes the same ongoing session in the directory below (--continue), so context carries over between restarts instead of starting over. It only runs when started below -- never launched automatically at boot.',
    'Siempre retoma la misma sesión en curso en el directorio de abajo (--continue), así que el contexto se mantiene entre reinicios en vez de empezar de cero. Solo corre cuando lo inicias abajo -- nunca se lanza solo al arrancar Unraid.'
)?></p>
<p><?=t(
    'If a session was archived on claude.ai (an action you take there, not something Claude does by itself) or otherwise can no longer be resumed, this is detected automatically after a few failed attempts and a new session starts in its place -- see the notice below when that happens.',
    'Si una sesión fue archivada en claude.ai (una acción que haces tú allí, no algo que hace Claude por su cuenta) o ya no se puede retomar por otro motivo, esto se detecta automáticamente tras varios intentos fallidos y arranca una sesión nueva en su lugar -- verás un aviso abajo cuando ocurra.'
)?></p>
<?php if ($multi_account && count($rc_accounts) > 1): ?>
<p><?=t(
    'Each account runs its own session and they can be connected at the same time. An account uses the directory set for it, or the one above if it has none, so pointing every account at the same directory is fine and is respected. The one thing worth knowing: a session is resumed by directory, so accounts sharing one may find each other\'s session there, fail to resume what is not theirs, and start a fresh session instead. Separate directories avoid that entirely.',
    'Cada cuenta ejecuta su propia sesión y pueden estar conectadas a la vez. Una cuenta usa el directorio que le pongas, o el de arriba si no le pones ninguno, así que apuntar todas las cuentas al mismo directorio es válido y se respeta. Lo único que conviene saber: una sesión se retoma por directorio, así que las cuentas que compartan uno pueden encontrarse la sesión de otra, no poder retomar lo que no es suyo, y arrancar una sesión nueva en su lugar. Con directorios distintos eso no pasa.'
)?></p>
<?php endif; ?>
</div>

<?php foreach ($rc_accounts as $rc): ?>
<div class="claude-box">
<?php if ($multi_account && count($rc_accounts) > 1): ?>
<h4><?=htmlspecialchars($rc['label'])?><?php if ($rc['email'] !== ''): ?> <span class="dim-text"><?=htmlspecialchars($rc['email'])?></span><?php endif; ?></h4>
<?php endif; ?>

<?php if ($rc['archived']): ?>
<div class="claude-notice">
<b><?=t('Notice:', 'Aviso:')?></b>
<?=t('The previous session could no longer be resumed (likely archived) -- a new session was started automatically.', 'La sesión anterior ya no se pudo retomar (probablemente archivada) -- se inició una nueva automáticamente.')?>
<br><code style="font-size:0.85em;"><?=htmlspecialchars($rc['archived'])?></code>
</div>
<?php endif; ?>

<dl>
<dt><?=t('Status:', 'Estado:')?></dt>
<dd><span class="<?=$rc['running'] ? 'ok' : 'warn'?>"><?=$rc['running'] ? t('Running', 'Corriendo') : t('Stopped', 'Detenido')?></span></dd>
</dl>
<?php if ($rc['session_url']): ?>
<dl>
<dt><?=t('Session:', 'Sesión:')?></dt>
<dd><a href="<?=htmlspecialchars($rc['session_url'])?>" target="_blank"><?=htmlspecialchars($rc['session_url'])?></a></dd>
</dl>
<?php endif; ?>
<dl>
<dt><?=t('Log:', 'Log:')?></dt>
<dd><a onclick="openTerminal('log','claude-code-rc-<?=htmlspecialchars($rc['slug'])?>','<?=htmlspecialchars($rc['log_name'])?>')" style="cursor:pointer;"><i class="fa fa-book"></i> <u><?=t('View live log', 'Ver log en vivo')?></u></a>
<?php if (!$rc['log_exists']): ?> <span class="dim-text">(<?=t('empty until this account is started', 'vacío hasta que se inicie esta cuenta')?>)</span><?php endif; ?></dd>
</dl>

<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$cfg_file?>">
<dl>
<dt><?=t('Directory:', 'Directorio:')?></dt>
<dd><input type="text" name="<?=htmlspecialchars($rc['dir_key'])?>" value="<?=htmlspecialchars($rc['dir_cfg'])?>" placeholder="<?=htmlspecialchars($rc['dir_default'])?>" class="narrow"></dd>
</dl>
<blockquote class="inline_help"><?=t(
    'Claude gets filesystem and command access to this directory. Defaults to a dedicated folder rather than /root itself, since Unraid never persists workspace trust for a home directory. If Remote Control is running, Stop and Start it again after changing this.',
    'Claude tendrá acceso a archivos y comandos en este directorio. Por defecto usa una carpeta dedicada en vez de /root directamente, porque Unraid nunca recuerda la confianza del workspace para un directorio home. Si Control Remoto está corriendo, Detenlo e Inícialo de nuevo después de cambiar esto.'
)?></blockquote>
<input type="submit" value="<?=t('Save Directory', 'Guardar Directorio')?>">
</form>

<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/claude-code/scripts/remote-control.sh">
<input type="hidden" name="#arg[0]" value="<?=$rc['running'] ? 'stop' : 'start'?>">
<input type="hidden" name="#arg[1]" value="<?=htmlspecialchars($rc['slug'])?>">
<input type="submit" value="<?=$rc['running'] ? t('Stop', 'Detener') : t('Start', 'Iniciar')?>">
</form>

<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/claude-code/scripts/remote-control.sh">
<input type="hidden" name="#arg[0]" value="connect">
<input type="hidden" name="#arg[1]" value="<?=htmlspecialchars($rc['slug'])?>">
<dl>
<dt><?=t('Session ID:', 'ID de sesión:')?></dt>
<dd>
<input type="text" name="#arg[2]" list="claude-session-history" value="<?=htmlspecialchars($rc['last_sid'])?>" placeholder="session_..." class="narrow">
</dd>
</dl>
<blockquote class="inline_help"><?=t(
    'Stops this account\'s current session (if any) and connects to a specific session id instead of the most recent one -- pick one from the history below, or paste an id from claude.ai/code. If that session can no longer be resumed either, it falls back to a fresh one automatically, same as above.',
    'Detiene la sesión actual de esta cuenta (si hay alguna) y conecta a un id de sesión concreto en vez de al más reciente -- elige uno del histórico de abajo, o pega un id de claude.ai/code. Si esa sesión tampoco se puede retomar, cae a una sesión nueva automáticamente, igual que arriba.'
)?></blockquote>
<input type="submit" value="<?=t('Connect to session ID', 'Conectar a ese ID de sesión')?>">
</form>
</div>
<?php endforeach; ?>

<datalist id="claude-session-history">
<?php foreach ($rc_history as $rc_sid => $rc_info): ?>
<option value="<?=htmlspecialchars($rc_sid)?>"><?=htmlspecialchars($rc_info['time'])?> -- <?=htmlspecialchars($rc_info['dir'])?></option>
<?php endforeach; ?>
</datalist>

<?php if (!empty($rc_history)): ?>
<div class="claude-box">
<h4><?=t('Session history', 'Histórico de sesiones')?></h4>
<table class="claude-history">
<tr><th><?=t('When', 'Cuándo')?></th><th><?=t('Session ID', 'ID de sesión')?></th><?php if ($multi_account): ?><th><?=t('Account', 'Cuenta')?></th><?php endif; ?><th><?=t('Directory', 'Directorio')?></th><th><?=t('State', 'Estado')?></th></tr>
<?php foreach ($rc_history as $rc_sid => $rc_info): ?>
<tr><td><?=htmlspecialchars($rc_info['time'])?></td><td><code><?=htmlspecialchars($rc_sid)?></code></td>
<?php if ($multi_account): ?><td><?php
$rc_owner = $rc_info['profile'] ?? '';
if ($rc_owner === '') {
    // Sessions found only through Claude's own pointer files carry no account.
    echo '<span class="dim-text" title="' . t('Started outside this plugin', 'Iniciada fuera de este plugin') . '">&mdash;</span>';
} else {
    $rc_name = $rc_owner;
    foreach ($rc_accounts as $rc_a) { if ($rc_a['slug'] === $rc_owner) { $rc_name = $rc_a['label']; break; } }
    echo htmlspecialchars($rc_name);
}
?></td><?php endif; ?>
<td><?php if ($rc_info['dir_known'] ?? true): ?><?=htmlspecialchars($rc_info['dir'])?><?php else: ?><span class="dim-text" title="<?=t('This directory no longer exists; showing the folder name Claude stored it under.', 'Este directorio ya no existe; se muestra el nombre de carpeta con el que Claude lo guardó.')?>"><?=htmlspecialchars($rc_info['dir'])?></span><?php endif; ?></td>
<td><?php if ($rc_info['live']): ?><span class="ok"><?=t('Connected', 'Conectada')?></span><?php else: ?><span class="dim-text"><?=t('Past', 'Anterior')?></span><?php endif; ?></td></tr>
<?php endforeach; ?>
</table>
<blockquote class="inline_help"><?=t(
    'Every session id this NAS knows about, most recent first: the ones this plugin connected to (kept on the flash share, so they survive reboots) plus the current session of every directory Claude has been used in, including sessions you started by hand from a terminal.',
    'Todos los IDs de sesión que conoce este NAS, más reciente primero: los que ha usado este plugin (guardados en el flash drive, así que sobreviven a reinicios) más la sesión actual de cada directorio donde se haya usado Claude, incluidas las que hayas iniciado a mano desde una terminal.'
)?></blockquote>
</div>
<?php endif; ?>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/claude-code/ClaudeCodeConfig.page">
<SHA256>a2683e408819c94c9c44a31497316953365691569c5c59e15c8998b4b670e76c</SHA256>
<INLINE>
<![CDATA[
Menu="claude-code:4"
Title="Claude Code Config"
Tag="sliders"
---
<?php require_once "/usr/local/emhttp/plugins/claude-code/include/common.php"; ?>
<?php
// Claude Code's own configuration, the file it reads as user settings:
// $APPDATA/.claude/settings.json. Everything on this tab is Anthropic's
// setting, not this plugin's -- the plugin's own options stay on the Settings
// tab. The full reference is linked at the bottom of the page, and the JSON
// editor below covers every key it lists, including the ones with no field
// here.
//
// The catalog below decides both what the form shows and how each value is
// typed when it is saved, so a field cannot render as a checkbox and be saved
// as a string. Types:
//   bool   three states: unset, true, false. Unset is not the same as false
//          for most of these keys, so it has to be expressible.
//   select one of a fixed list, or unset
//   text   free text, unset when empty
//   number whole number, unset when empty
//   lines  array of strings, one per line
//   kv     object of NAME=value lines
$cc_fields = [
  [
    'title' => t('Model and responses', 'Modelo y respuestas'),
    'help'  => t('Claude Code applies most of these to a running session as soon as you save. The model, the effort level and the output style are read when a session starts, so those reach the next session rather than the one open now.',
                 'Claude Code aplica la mayoría en cuanto guardas, incluso con una sesión abierta. El modelo, el nivel de esfuerzo y el estilo de salida se leen al iniciar la sesión, así que esos afectan a la siguiente, no a la que ya está abierta.'),
    'fields' => [
      ['key' => 'model', 'type' => 'text', 'list' => ['default', 'sonnet', 'opus', 'haiku', 'opusplan', 'claude-sonnet-5', 'claude-opus-5', 'claude-haiku-4-5'],
       'label' => t('Model', 'Modelo'),
       'help'  => t('Model every new session starts with: an alias such as sonnet or opus, or a full model ID. Empty means your account default.',
                    'Modelo con el que arranca cada sesión: un alias como sonnet u opus, o un ID completo. Vacío usa el modelo por defecto de tu cuenta.')],
      ['key' => 'fallbackModel', 'type' => 'lines',
       'label' => t('Fallback models', 'Modelos de respaldo'),
       'help'  => t('One per line. Tried in order when the model above is overloaded or unavailable.',
                    'Uno por línea. Se prueban en orden cuando el modelo de arriba está saturado o no disponible.')],
      ['key' => 'effortLevel', 'type' => 'select', 'options' => ['low', 'medium', 'high', 'xhigh'],
       'label' => t('Effort level', 'Nivel de esfuerzo'),
       'help'  => t('How much reasoning Claude spends by default. Lower is faster and cheaper; higher thinks more and uses more of your plan.',
                    'Cuánto razona Claude por defecto. Más bajo es más rápido y gasta menos; más alto piensa más y consume más plan.')],
      ['key' => 'outputStyle', 'type' => 'text',
       'label' => t('Output style', 'Estilo de salida'),
       'help'  => t('Name of a built-in or custom output style, which changes the instructions Claude works under.',
                    'Nombre de un estilo de salida integrado o propio, que cambia las instrucciones con las que trabaja Claude.')],
      ['key' => 'alwaysThinkingEnabled', 'type' => 'bool',
       'label' => t('Extended thinking', 'Pensamiento extendido'),
       'help'  => t('On by default for models that support it. Set it to No to turn it off for every session.',
                    'Activado por defecto en los modelos que lo admiten. Ponlo en No para desactivarlo en todas las sesiones.')],
      ['key' => 'language', 'type' => 'text',
       'label' => t('Response language', 'Idioma de las respuestas'),
       'help'  => t('A language name, such as spanish or english. Claude Code adds it to the system prompt verbatim.',
                    'Un nombre de idioma, por ejemplo spanish o english. Claude Code lo añade tal cual a las instrucciones del sistema.')],
      ['key' => 'autoCompactEnabled', 'type' => 'bool',
       'label' => t('Auto-compact conversation', 'Compactar conversación automáticamente'),
       'help'  => t('Summarises the conversation on its own when the context window fills up. On by default.',
                    'Resume la conversación por su cuenta cuando la ventana de contexto se llena. Activado por defecto.')],
      ['key' => 'theme', 'type' => 'select', 'options' => ['auto', 'dark', 'light', 'dark-daltonized', 'light-daltonized', 'dark-ansi', 'light-ansi'],
       'label' => t('Theme', 'Tema'),
       'help'  => t('Colour theme of the terminal interface.', 'Tema de color de la interfaz en la terminal.')],
      ['key' => 'editorMode', 'type' => 'select', 'options' => ['normal', 'vim'],
       'label' => t('Editor mode', 'Modo de edición'),
       'help'  => t('Key bindings in the prompt: standard, or vim with its normal/insert/visual modes.',
                    'Atajos de teclado al escribir: estándar, o vim con sus modos normal/insert/visual.')],
      ['key' => 'verbose', 'type' => 'bool',
       'label' => t('Verbose output', 'Salida detallada'),
       'help'  => t('Show each tool call in full instead of collapsing it to a summary line.',
                    'Muestra cada llamada a herramienta completa en vez de resumirla en una línea.')],
      ['key' => 'spinnerTipsEnabled', 'type' => 'bool',
       'label' => t('Tips while working', 'Consejos mientras trabaja'),
       'help'  => t('The rotating tips next to the spinner. On by default.',
                    'Los consejos que van rotando junto al indicador de actividad. Activados por defecto.')],
    ],
  ],
  [
    'title' => t('Permissions', 'Permisos'),
    'help'  => t('What Claude may do without stopping to ask. Rules are written as Tool(argument), e.g. Bash(git status:*) or Read(/mnt/user/**). These apply as soon as you save, including to a session that is already open.',
                 'Lo que Claude puede hacer sin preguntar. Las reglas se escriben como Herramienta(argumento), por ejemplo Bash(git status:*) o Read(/mnt/user/**). Se aplican al guardar, incluso a una sesión ya abierta.'),
    'fields' => [
      ['key' => 'permissions.defaultMode', 'type' => 'select',
       'options' => ['default', 'acceptEdits', 'plan', 'auto', 'dontAsk', 'bypassPermissions'],
       'label' => t('Default permission mode', 'Modo de permisos por defecto'),
       'help'  => t('The mode new sessions start in. default asks before anything that is not a read; acceptEdits also allows edits; plan blocks changes until you approve a plan; bypassPermissions asks for nothing at all, which on a server reachable from outside is worth thinking twice about.',
                    'El modo con el que arrancan las sesiones nuevas. default pregunta antes de todo lo que no sea lectura; acceptEdits permite además las ediciones; plan bloquea los cambios hasta que apruebes un plan; bypassPermissions no pregunta nada, algo que conviene pensarse dos veces en un servidor accesible desde fuera.')],
      ['key' => 'permissions.allow', 'type' => 'lines',
       'label' => t('Always allow', 'Permitir siempre'),
       'help'  => t('One rule per line. These run without asking.', 'Una regla por línea. Se ejecutan sin preguntar.')],
      ['key' => 'permissions.ask', 'type' => 'lines',
       'label' => t('Always ask', 'Preguntar siempre'),
       'help'  => t('One rule per line. These always prompt, even in a permissive mode.',
                    'Una regla por línea. Siempre preguntan, incluso en un modo permisivo.')],
      ['key' => 'permissions.deny', 'type' => 'lines',
       'label' => t('Never allow', 'No permitir nunca'),
       'help'  => t('One rule per line. These are refused outright; a deny rule beats an allow rule.',
                    'Una regla por línea. Se rechazan siempre; una regla de denegar gana a una de permitir.')],
      ['key' => 'permissions.additionalDirectories', 'type' => 'lines',
       'label' => t('Additional directories', 'Directorios adicionales'),
       'help'  => t('One path per line. Directories Claude may work in besides the one the session started from, e.g. /mnt/user/appdata.',
                    'Una ruta por línea. Directorios en los que Claude puede trabajar además del de arranque de la sesión, por ejemplo /mnt/user/appdata.')],
    ],
  ],
  [
    'title' => t('Remote Control', 'Control Remoto'),
    'help'  => t('These are Claude Code\'s own Remote Control settings, and they apply to every session on this server, including sessions you start by hand in a terminal. Starting and stopping the bridge this plugin supervises stays on the Remote Control tab.',
                 'Estos son los ajustes de Control Remoto del propio Claude Code y afectan a todas las sesiones de este servidor, incluidas las que abras a mano en una terminal. Arrancar y parar el puente que supervisa este plugin sigue estando en la pestaña Control Remoto.'),
    'fields' => [
      ['key' => 'remoteControlAtStartup', 'type' => 'bool',
       'label' => t('Connect at session start', 'Conectar al iniciar sesión'),
       'help'  => t('Connect Remote Control automatically whenever an interactive session starts, instead of waiting for /remote-control.',
                    'Conecta el Control Remoto automáticamente al abrir una sesión interactiva, en vez de esperar a /remote-control.')],
      ['key' => 'disableRemoteControl', 'type' => 'bool',
       'label' => t('Disable Remote Control', 'Desactivar Control Remoto'),
       'help'  => t('Yes refuses Remote Control entirely, including this plugin\'s own service. Leave it unset unless you want it off.',
                    'Sí rechaza el Control Remoto por completo, incluido el servicio de este plugin. Déjalo sin definir salvo que lo quieras desactivado.')],
    ],
  ],
  [
    'title' => t('Environment and maintenance', 'Entorno y mantenimiento'),
    'help'  => '',
    'fields' => [
      ['key' => 'env', 'type' => 'kv',
       'label' => t('Environment variables', 'Variables de entorno'),
       'help'  => t('One NAME=value per line. Set for every session and for the processes it starts. Anything you put here is stored in plain text in this file.',
                    'Un NOMBRE=valor por línea. Se aplican a cada sesión y a los procesos que lance. Lo que pongas aquí queda en texto plano en este archivo.')],
      ['key' => 'cleanupPeriodDays', 'type' => 'number',
       'label' => t('Keep transcripts for (days)', 'Conservar transcripciones (días)'),
       'help'  => t('How many days Claude Code keeps session transcripts before deleting them. 30 by default. This does not touch agent memory.',
                    'Cuántos días conserva Claude Code las transcripciones de sesión antes de borrarlas. 30 por defecto. No afecta a la memoria del agente.')],
      ['key' => 'autoMemoryEnabled', 'type' => 'bool',
       'label' => t('Auto memory', 'Memoria automática'),
       'help'  => t('Whether Claude reads and writes its automatic memory directory. On by default.',
                    'Si Claude lee y escribe su directorio de memoria automática. Activada por defecto.')],
      ['key' => 'respectGitignore', 'type' => 'bool',
       'label' => t('Respect .gitignore', 'Respetar .gitignore'),
       'help'  => t('Leave files matched by .gitignore out of the @ file picker. On by default.',
                    'Deja fuera del selector de archivos @ lo que coincida con .gitignore. Activado por defecto.')],
      ['key' => 'disableAllHooks', 'type' => 'bool',
       'label' => t('Disable all hooks', 'Desactivar todos los hooks'),
       'help'  => t('Turns off every hook, custom status line and custom file-suggestion command at once.',
                    'Desactiva de golpe todos los hooks, la línea de estado personalizada y los comandos de sugerencia de archivos.')],
      ['key' => 'autoUpdatesChannel', 'type' => 'select', 'options' => ['latest', 'stable'],
       'label' => t('Update channel', 'Canal de actualización'),
       'help'  => t('Which releases Check for Updates follows: latest is the newest release, stable is about a week behind and skips releases with known regressions.',
                    'Qué versiones sigue Buscar actualizaciones: latest es la más reciente, stable va una semana por detrás y se salta las versiones con regresiones conocidas.')],
      ['key' => 'timeZone', 'type' => 'text',
       'label' => t('Time zone', 'Zona horaria'),
       'help'  => t('An IANA name such as Europe/Madrid. Empty uses the server time zone.',
                    'Un nombre IANA como Europe/Madrid. Vacío usa la zona horaria del servidor.')],
    ],
  ],
];

// The files this tab can edit, and the account each one belongs to. With the
// accounts feature off, or on in shared mode, there is a single shared file:
// the accounts share a config home, so a change here applies to all of them.
$cc_shared = !($multi_account && $account_mode === 'isolated');
$cc_files = [];
if ($cc_shared) {
    $cc_files[] = ['slug' => 'default', 'label' => t('All accounts', 'Todas las cuentas'), 'path' => "$appdata_path/.claude/settings.json"];
} else {
    foreach (($profiles ?: [['slug' => 'default', 'label' => t('Main account', 'Cuenta principal'), 'email' => '']]) as $cc_p) {
        $cc_files[] = [
            'slug'  => $cc_p['slug'],
            'label' => ($cc_p['email'] ?? '') !== '' ? $cc_p['email'] : $cc_p['label'],
            'path'  => $cc_p['slug'] === 'default' ? "$appdata_path/.claude/settings.json"
                                                   : "$appdata_path/profiles/{$cc_p['slug']}/settings.json",
        ];
    }
}

// Current contents, read once per file here rather than fetched by the browser:
// the values have to be in the fields on first paint, not a moment later.
foreach ($cc_files as $cc_i => $cc_f) {
    $cc_raw = is_readable($cc_f['path']) ? (string)@file_get_contents($cc_f['path']) : '';
    $cc_parsed = $cc_raw === '' ? [] : json_decode($cc_raw, true);
    $cc_files[$cc_i]['raw']      = $cc_raw;
    $cc_files[$cc_i]['exists']   = $cc_raw !== '';
    $cc_files[$cc_i]['valid']    = $cc_raw === '' || is_array($cc_parsed);
    $cc_files[$cc_i]['settings'] = is_array($cc_parsed) ? $cc_parsed : [];
}

// Reads one dotted key out of a parsed settings document.
function cc_get($settings, $dotted) {
    $ref = $settings;
    foreach (explode('.', $dotted) as $part) {
        if (!is_array($ref) || !array_key_exists($part, $ref)) return null;
        $ref = $ref[$part];
    }
    return $ref;
}

// Turns a stored value into what the field shows. Everything the form manages
// is a string, a number, a boolean, a list of strings or a flat object, and a
// value of any other shape is left to the JSON editor rather than being
// flattened into a field that could not save it back.
function cc_field_value($type, $value) {
    if ($value === null) return '';
    switch ($type) {
        case 'bool':   return $value === true ? 'true' : ($value === false ? 'false' : '');
        case 'number': return is_numeric($value) ? (string)$value : '';
        case 'lines':  return is_array($value) ? implode("\n", array_filter($value, 'is_scalar')) : '';
        case 'kv':
            if (!is_array($value)) return '';
            $out = [];
            foreach ($value as $k => $v) if (is_scalar($v)) $out[] = "$k=$v";
            return implode("\n", $out);
        default:       return is_scalar($value) ? (string)$value : '';
    }
}

// The type of every field, for the browser: it decides there whether a value
// travels as a string, a number, a boolean or a list, so a field cannot be
// saved in a shape Claude Code would reject.
$cc_types = [];
foreach ($cc_fields as $cc_g) foreach ($cc_g['fields'] as $cc_fd) $cc_types[$cc_fd['key']] = $cc_fd['type'];
?>

<p><?=t(
  'Claude Code\'s own settings: the model it uses, what it may do without asking, its environment and its housekeeping. This is Anthropic\'s configuration file, not this plugin\'s -- the plugin\'s own options are on the Settings tab.',
  'La configuración del propio Claude Code: el modelo que usa, lo que puede hacer sin preguntar, su entorno y su mantenimiento. Este es el archivo de configuración de Anthropic, no el de este plugin -- las opciones del plugin están en la pestaña Ajustes.'
)?></p>

<div class="claude-status">
<b><?=t('File:', 'Archivo:')?></b> <code id="cc-path"><?=htmlspecialchars($cc_files[0]['path'])?></code>
<span class="sep">&middot;</span>
<?php if ($cc_shared): ?>
<span class="ok"><?=t('shared by every account on this server', 'compartido por todas las cuentas de este servidor')?></span>
<?php else: ?>
<span class="ok"><?=t('one file per account (separate accounts mode)', 'un archivo por cuenta (modo de cuentas separadas)')?></span>
<?php endif; ?>
</div>

<?php if (count($cc_files) > 1): ?>
<div class="claude-box">
<h4><?=t('Account', 'Cuenta')?></h4>
<dl>
<dt><?=t('Editing settings for:', 'Editando la configuración de:')?></dt>
<dd><select id="cc-account" onchange="ccSelect(this.value)">
<?php foreach ($cc_files as $cc_f): ?>
<option value="<?=htmlspecialchars($cc_f['slug'])?>"><?=htmlspecialchars($cc_f['label'])?></option>
<?php endforeach; ?>
</select></dd>
</dl>
<blockquote class="inline_help"><?=t('Each account keeps its own config directory in separate-accounts mode, so each one has its own settings file.',
                                     'En el modo de cuentas separadas cada cuenta tiene su propio directorio de configuración, así que cada una tiene su propio archivo de ajustes.')?></blockquote>
</div>
<?php endif; ?>

<?php foreach ($cc_files as $cc_idx => $cc_f): ?>
<div class="cc-pane" id="cc-pane-<?=htmlspecialchars($cc_f['slug'])?>" data-path="<?=htmlspecialchars($cc_f['path'])?>"<?=$cc_idx ? ' style="display:none;"' : ''?>>

<?php if (!$cc_f['valid']): ?>
<div class="claude-notice"><?=t('This settings file is not valid JSON, so the fields below cannot be filled in or saved. Fix it in the JSON editor at the bottom of this tab.',
                                'Este archivo de ajustes no es JSON válido, así que los campos de abajo no se pueden rellenar ni guardar. Corrígelo en el editor JSON del final de esta pestaña.')?></div>
<?php endif; ?>

<?php foreach ($cc_fields as $cc_g): ?>
<div class="claude-box">
<h4><?=htmlspecialchars($cc_g['title'])?></h4>
<?php if ($cc_g['help'] !== ''): ?><p><?=htmlspecialchars($cc_g['help'])?></p><?php endif; ?>
<?php foreach ($cc_g['fields'] as $cc_fd):
    $cc_id = 'cc-' . $cc_f['slug'] . '-' . str_replace('.', '_', $cc_fd['key']);
    $cc_val = cc_field_value($cc_fd['type'], cc_get($cc_f['settings'], $cc_fd['key']));
?>
<dl>
<dt><?=htmlspecialchars($cc_fd['label'])?></dt>
<dd>
<?php if ($cc_fd['type'] === 'bool'): ?>
  <select id="<?=$cc_id?>" data-key="<?=htmlspecialchars($cc_fd['key'])?>">
    <option value=""<?=$cc_val === '' ? ' selected' : ''?>><?=t('Not set (Claude Code default)', 'Sin definir (valor por defecto)')?></option>
    <option value="true"<?=$cc_val === 'true' ? ' selected' : ''?>><?=t('Yes', 'Sí')?></option>
    <option value="false"<?=$cc_val === 'false' ? ' selected' : ''?>><?=t('No', 'No')?></option>
  </select>
<?php elseif ($cc_fd['type'] === 'select'): ?>
  <select id="<?=$cc_id?>" data-key="<?=htmlspecialchars($cc_fd['key'])?>">
    <option value=""<?=$cc_val === '' ? ' selected' : ''?>><?=t('Not set (Claude Code default)', 'Sin definir (valor por defecto)')?></option>
    <?php foreach ($cc_fd['options'] as $cc_o): ?>
    <option value="<?=htmlspecialchars($cc_o)?>"<?=$cc_val === $cc_o ? ' selected' : ''?>><?=htmlspecialchars($cc_o)?></option>
    <?php endforeach; ?>
  </select>
<?php elseif ($cc_fd['type'] === 'lines' || $cc_fd['type'] === 'kv'): ?>
  <textarea id="<?=$cc_id?>" data-key="<?=htmlspecialchars($cc_fd['key'])?>" rows="4" cols="60" spellcheck="false"><?=htmlspecialchars($cc_val)?></textarea>
<?php elseif ($cc_fd['type'] === 'number'): ?>
  <input type="number" min="1" step="1" id="<?=$cc_id?>" data-key="<?=htmlspecialchars($cc_fd['key'])?>" value="<?=htmlspecialchars($cc_val)?>" class="narrow">
<?php else: ?>
  <input type="text" id="<?=$cc_id?>" data-key="<?=htmlspecialchars($cc_fd['key'])?>" value="<?=htmlspecialchars($cc_val)?>" class="narrow"
    <?php if (!empty($cc_fd['list'])): ?>list="<?=$cc_id?>-list"<?php endif; ?>>
  <?php if (!empty($cc_fd['list'])): ?>
  <datalist id="<?=$cc_id?>-list"><?php foreach ($cc_fd['list'] as $cc_o): ?><option value="<?=htmlspecialchars($cc_o)?>"><?php endforeach; ?></datalist>
  <?php endif; ?>
<?php endif; ?>
</dd>
</dl>
<blockquote class="inline_help"><?=htmlspecialchars($cc_fd['help'])?></blockquote>
<?php endforeach; ?>
</div>
<?php endforeach; ?>

<div class="claude-box">
<h4><?=t('Save', 'Guardar')?></h4>
<p><?=t('Saves only the fields on this tab. Anything else already in the file -- hooks, a status line, MCP settings -- is read, kept and written back unchanged, and the previous version is left beside it as settings.json.bak.',
        'Guarda solo los campos de esta pestaña. Lo demás que ya haya en el archivo -- hooks, línea de estado, ajustes de MCP -- se lee, se conserva y se vuelve a escribir igual, y la versión anterior queda al lado como settings.json.bak.')?></p>
<input type="button" value="<?=t('Save settings', 'Guardar ajustes')?>" onclick="ccSave('<?=htmlspecialchars($cc_f['slug'])?>')">
<span id="cc-msg-<?=htmlspecialchars($cc_f['slug'])?>" style="margin-left:10px;"></span>
</div>

<div class="claude-box">
<h4><?=t('All options (JSON)', 'Todas las opciones (JSON)')?></h4>
<p><?=t('The whole file, for the keys that have no field above. Saving here replaces the document, so it is the one place where a key can be added or removed by hand.',
        'El archivo completo, para las claves que no tienen campo arriba. Guardar aquí reemplaza el documento entero, así que es el único sitio donde añadir o quitar una clave a mano.')?></p>
<textarea id="cc-raw-<?=htmlspecialchars($cc_f['slug'])?>" rows="16" cols="90" spellcheck="false" style="font-family:monospace;"><?=htmlspecialchars($cc_f['raw'] !== '' ? $cc_f['raw'] : "{\n}\n")?></textarea>
<blockquote class="inline_help"><?=t('Checked before anything is written: invalid JSON is refused and the file on disk is left as it was. The previous version is kept as settings.json.bak.',
                                     'Se comprueba antes de escribir nada: un JSON inválido se rechaza y el archivo del disco se queda como estaba. La versión anterior se guarda como settings.json.bak.')?></blockquote>
<input type="button" value="<?=t('Save JSON', 'Guardar JSON')?>" onclick="ccSaveRaw('<?=htmlspecialchars($cc_f['slug'])?>')">
<span id="cc-rawmsg-<?=htmlspecialchars($cc_f['slug'])?>" style="margin-left:10px;"></span>
<p><?=t('Every available key is documented at', 'Todas las claves disponibles están documentadas en')?>
   <a href="https://code.claude.com/docs/en/settings-reference" target="_blank">code.claude.com/docs/en/settings-reference</a>.</p>
</div>

</div>
<?php endforeach; ?>

<script>
(function () {
  var TYPES = <?=json_encode($cc_types)?>;
  var PATHS = <?=json_encode(array_column($cc_files, 'path', 'slug'))?>;
  var L = <?=json_encode([
      'saving'  => t('Saving...', 'Guardando...'),
      'saved'   => t('Saved', 'Guardado'),
      'network' => t('Could not reach the server', 'No se pudo contactar con el servidor'),
      'badnum'  => t('is not a whole number', 'no es un número entero'),
      'badkv'   => t('must be written as NAME=value, one per line', 'debe escribirse como NOMBRE=valor, uno por línea'),
  ])?>;
  // Every POST to a page under the webGUI needs this token or PHP's prepend
  // file ends the request with an empty body, which arrives here looking
  // exactly like the server being unreachable.
  var CSRF = <?=json_encode($var['csrf_token'] ?? '')?>;
  var ENDPOINT = '/plugins/claude-code/include/claude-config.php';

  function el(id) { return document.getElementById(id); }

  window.ccSelect = function (slug) {
    var panes = document.getElementsByClassName('cc-pane');
    for (var i = 0; i < panes.length; i++) panes[i].style.display = (panes[i].id === 'cc-pane-' + slug) ? '' : 'none';
    if (el('cc-path')) el('cc-path').textContent = PATHS[slug] || '';
  };

  // Turns what is in the fields into the JSON types settings.json expects. An
  // empty field means "not set" and travels as null, which removes the key
  // rather than writing an empty string Claude Code would have to interpret.
  function collect(slug, msg) {
    var values = {}, key, node, raw;
    for (key in TYPES) {
      node = el('cc-' + slug + '-' + key.replace(/\./g, '_'));
      if (!node) continue;
      raw = (node.value || '').trim();
      if (raw === '') { values[key] = null; continue; }
      switch (TYPES[key]) {
        case 'bool':
          values[key] = (raw === 'true');
          break;
        case 'number':
          if (!/^\d+$/.test(raw)) { msg(key + ': ' + L.badnum, false); return null; }
          values[key] = parseInt(raw, 10);
          break;
        case 'lines':
          var list = raw.split('\n').map(function (s) { return s.trim(); }).filter(function (s) { return s !== ''; });
          values[key] = list.length ? list : null;
          break;
        case 'kv':
          var obj = {}, any = false, bad = false;
          raw.split('\n').forEach(function (line) {
            line = line.trim();
            if (line === '') return;
            var eq = line.indexOf('=');
            if (eq < 1) { bad = true; return; }
            obj[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
            any = true;
          });
          if (bad) { msg(key + ': ' + L.badkv, false); return null; }
          values[key] = any ? obj : null;
          break;
        default:
          values[key] = raw;
      }
    }
    return values;
  }

  function post(body, node, onOk) {
    body.set('csrf_token', CSRF);
    node.textContent = L.saving;
    node.className = '';
    fetch(ENDPOINT, { method: 'POST', cache: 'no-store', headers: { 'X-CSRF-TOKEN': CSRF }, body: body })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        node.textContent = d.ok ? (L.saved + ' — ' + (d.path || '')) : (d.message || '');
        node.className = d.ok ? 'ok' : 'error';
        if (d.ok && onOk) onOk(d);
      })
      .catch(function () { node.textContent = L.network; node.className = 'error'; });
  }

  window.ccSave = function (slug) {
    var node = el('cc-msg-' + slug);
    var show = function (text, ok) { node.textContent = text; node.className = ok ? 'ok' : 'error'; };
    var values = collect(slug, show);
    if (values === null) return;
    var body = new URLSearchParams();
    body.set('action', 'save');
    body.set('profile', slug);
    body.set('values', JSON.stringify(values));
    post(body, node, function (d) {
      // Keep the JSON editor in step with what was just written, so the two
      // halves of this tab never show different files.
      var box = el('cc-raw-' + slug);
      if (box && typeof d.raw === 'string') box.value = d.raw;
    });
  };

  window.ccSaveRaw = function (slug) {
    var node = el('cc-rawmsg-' + slug);
    var body = new URLSearchParams();
    body.set('action', 'save');
    body.set('profile', slug);
    body.set('raw', el('cc-raw-' + slug).value);
    post(body, node, function () { setTimeout(function () { location.reload(); }, 900); });
  };
})();
</script>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/claude-code/ClaudeCodeSettings.page">
<SHA256>f7d08e02a223c93ce35ed86b3aed9e7d86669744bd266af387754506c2440d54</SHA256>
<INLINE>
<![CDATA[
Menu="claude-code:5"
Title="Settings"
Tag="cog"
---
<?php require_once "/usr/local/emhttp/plugins/claude-code/include/common.php"; ?>
<div class="claude-box">
<h4><?=t('Settings', 'Configuración')?></h4>
<form method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$cfg_file?>">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh">
<dl>
<dt><?=t('Appdata Path:', 'Ruta de appdata:')?></dt>
<dd><input type="text" name="APPDATA_PATH" value="<?=htmlspecialchars($appdata_path)?>" class="narrow"></dd>
</dl>
<blockquote class="inline_help"><?=t('Store Claude config on your array to avoid flash wear.', 'Guarda la configuración de Claude en tu array para no desgastar el flash drive.')?></blockquote>
