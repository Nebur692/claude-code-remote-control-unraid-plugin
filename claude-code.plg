<!-- Short bilingual blurb shown on the Plugins tab (dynamix.plugin.manager's
     ShowPlugins.php renders plugins/claude-code/README.md as the row's
     description, falling back to a bare "**claude-code**" if this is
     missing) — separate from this repo's own top-level README.md. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/README.md" Mode="0644">
<SHA256>5c6b2edc08dd9e2ba0397685559292d7085d713de0181e132bc4b1e1fda3eaf5</SHA256>
<INLINE>
<![CDATA[
**Claude Code Remote Control**

AI-powered coding assistant CLI from Anthropic, installed on Unraid with persistent
authentication across reboots. Run `claude` from the Unraid terminal, or drive a session from
claude.ai/code or the Claude mobile app using Remote Control. Supports several Claude accounts
at once, signed in from the browser, with plan usage and limits reported per account. Configure
it all from Settings > Utilities > Claude Code.

---

Asistente de programación con IA de Anthropic, instalado en Unraid con autenticación
persistente entre reinicios. Ejecuta `claude` desde la terminal de Unraid, o controla una sesión
desde claude.ai/code o la app móvil de Claude con Control Remoto. Admite varias cuentas de Claude
a la vez, con inicio de sesión desde el navegador y el uso y los límites del plan por cuenta.
Configúralo todo desde Settings > Utilities > Claude Code.
]]>
</INLINE>
</FILE>

<!-- Configuration file (only created if not exists, to preserve user settings across reinstalls) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
if [ ! -f /boot/config/plugins/claude-code/claude-code.cfg ]; then
    echo 'APPDATA_PATH=""' > /boot/config/plugins/claude-code/claude-code.cfg
fi
]]>
</INLINE>
</FILE>

<!-- Install/setup script -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh" Mode="0755">
<SHA256>120731e684c43464976d106b235c7d5152642f9cd57bb40eaf1ef0360c917ed4</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash

# Don't use set -e - we want to continue even if some steps fail

# Scripts launched from the web UI inherit a minimal PATH from emhttpd --
# /bin:/sbin:/usr/bin:/usr/sbin -- which contains neither /usr/local/bin
# (where ensure_symlink puts the launcher) nor /root/.local/bin (where the
# native installer puts the binary). Without this, "command -v claude" below
# fails on a perfectly working install and this script ends with a bogus
# "Installation Incomplete".
export PATH="/usr/local/bin:/root/.local/bin:$PATH"

PLUGIN_CFG="/boot/config/plugins/claude-code/claude-code.cfg"
CLAUDE_CONFIG_RUNTIME="/root/.claude"

# Load config
if [ -f "$PLUGIN_CFG" ]; then
    source "$PLUGIN_CFG"
fi

# Auto-detect appdata path if not set
AUTO_DETECTED=false
if [ -z "$APPDATA_PATH" ]; then
    AUTO_DETECTED=true
    echo "Auto-detecting appdata path..."

    # Method 1: Check Docker default storage path
    if [ -f "/boot/config/docker.cfg" ]; then
        DOCKER_APPDATA=$(grep -E '^DOCKER_APP_CONFIG_PATH=' /boot/config/docker.cfg 2>/dev/null | cut -d'"' -f2)
        if [ -n "$DOCKER_APPDATA" ] && [ -d "$(dirname "$DOCKER_APPDATA")" ]; then
            APPDATA_PATH="${DOCKER_APPDATA%/}/claude-code"
            echo "Detected from Docker config: $APPDATA_PATH"
        fi
    fi

    # Method 2: Look for existing appdata directories
    if [ -z "$APPDATA_PATH" ]; then
        for candidate in /mnt/user/appdata /mnt/disks/*/appdata /mnt/cache/appdata; do
            if [ -d "$candidate" ]; then
                APPDATA_PATH="$candidate/claude-code"
                echo "Found appdata directory: $APPDATA_PATH"
                break
            fi
        done
    fi

    # Fallback
    if [ -z "$APPDATA_PATH" ]; then
        APPDATA_PATH="/mnt/user/appdata/claude-code"
        echo "Using default: $APPDATA_PATH"
    fi
fi

CACHED_BINARY="$APPDATA_PATH/bin/claude"

echo "=== Claude Code Installation ==="

ensure_symlink() {
    # /usr/local/bin/claude is what interactive shells find on PATH, since they
    # do not have ~/.local/bin in it. This used to be a plain symlink to the
    # real binary; it is now a small wrapper that applies whichever account is
    # selected on the Settings page. With multi-account off, or with the main
    # account selected, the wrapper sets nothing and hands straight over, so
    # the behaviour is identical to the symlink it replaces.
    local launcher="/usr/local/emhttp/plugins/claude-code/scripts/claude-launcher.sh"
    local target="/usr/local/bin/claude"
    local candidate found=""

    for candidate in /root/.local/bin/claude /root/.claude/local/bin/claude; do
        if [ -x "$candidate" ]; then
            found="$candidate"
            break
        fi
    done
    [ -z "$found" ] && return 1

    if [ -f "$launcher" ]; then
        # Replace whatever is there -- an older version's plain symlink, or an
        # earlier generation of this wrapper. cmp against a symlink compares
        # the binary it points at, so that case reinstalls correctly too.
        if ! cmp -s "$launcher" "$target" 2>/dev/null; then
            rm -f "$target"
            if cp "$launcher" "$target" && chmod 755 "$target"; then
                echo "Installed the account-aware claude launcher at $target"
            else
                # Never leave claude off PATH because the wrapper failed.
                ln -sf "$found" "$target"
                echo "WARNING: could not install the launcher; fell back to a symlink."
            fi
        fi
        return 0
    fi

    # No launcher deployed (partial install): keep the original behaviour.
    if [ ! -x "$target" ]; then
        ln -sf "$found" "$target"
        echo "Symlinked $found -> $target"
    fi
    return 0
}

# Copying over a binary something is currently executing fails with "Text file
# busy", which on this server is the normal case rather than the exception:
# Remote Control keeps a claude running. Writing beside the target and renaming
# over it always works -- rename swaps the directory entry and processes
# already running keep the old inode -- and the exit status is what decides
# whether the caller may report success. Same helper as in update-claude.sh.
apply_binary() {
    local src="$1" dst="$2" tmp="$2.new.$$"
    if ! cp "$src" "$tmp"; then rm -f "$tmp"; return 1; fi
    if ! chmod +x "$tmp"; then rm -f "$tmp"; return 1; fi
    if ! mv -f "$tmp" "$dst"; then rm -f "$tmp"; return 1; fi
    return 0
}

restore_cached_binary() {
    # Restore binary from appdata cache (avoids re-downloading on every boot)
    if [ -f "$CACHED_BINARY" ]; then
        echo "Restoring Claude Code from cache..."
        mkdir -p /root/.local/bin
        if cmp -s "$CACHED_BINARY" /root/.local/bin/claude; then
            echo "Cached binary is already the one installed."
            return 0
        fi
        if apply_binary "$CACHED_BINARY" /root/.local/bin/claude; then
            return 0
        fi
        echo "Could not write /root/.local/bin/claude from the cache."
        return 1
    fi
    return 1
}

cache_binary() {
    # Cache the binary to appdata so it survives reboots
    if [ -x /root/.local/bin/claude ]; then
        mkdir -p "$APPDATA_PATH/bin"
        if apply_binary /root/.local/bin/claude "$CACHED_BINARY"; then
            echo "Cached Claude binary for future boots."
        else
            echo "WARNING: could not cache the Claude binary to $CACHED_BINARY."
        fi
    fi
}

install_claude_code() {
    # Check if claude works (not just exists)
    local ver
    ver=$(claude --version 2>/dev/null)
    if [ -n "$ver" ]; then
        echo "Claude Code already installed: $ver"
        ensure_symlink
        return 0
    fi

    # Try restoring from cache first (fast, no network needed)
    if restore_cached_binary; then
        ensure_symlink
        ver=$(claude --version 2>/dev/null)
        if [ -n "$ver" ]; then
            echo "Claude Code restored from cache: $ver"
            return 0
        fi
        echo "Cached binary didn't work, falling back to installer..."
    fi

    # Full install via native installer
    echo "Installing Claude Code via native installer..."
    local installer
    installer=$(mktemp /tmp/claude-install.XXXXXX)
    if ! curl -fsSL https://claude.ai/install.sh -o "$installer"; then
        echo "Failed to download installer."
        rm -f "$installer"
        return 1
    fi
    if ! bash "$installer"; then
        echo "Installer script failed."
        rm -f "$installer"
        return 1
    fi
    rm -f "$installer"

    ensure_symlink
    cache_binary

    if command -v claude &> /dev/null; then
        echo "Claude Code installed successfully!"
    else
        echo "WARNING: Claude Code installer completed but 'claude' not found in PATH"
        return 1
    fi
}

wait_for_appdata_mount() {
    # Determine the mount point for our appdata path
    local wait_mount="/mnt/user"
    case "$APPDATA_PATH" in
        /mnt/disks/*)
            # Unassigned Devices: extract mount like /mnt/disks/vms
            wait_mount=$(echo "$APPDATA_PATH" | cut -d/ -f1-4)
            ;;
        /mnt/cache/*)
            wait_mount="/mnt/cache"
            ;;
    esac

    local max_wait=120
    local waited=0
    echo "Waiting for $wait_mount..."
    while [ $waited -lt $max_wait ]; do
        if mountpoint -q "$wait_mount" 2>/dev/null; then
            echo "$wait_mount is available."
            return 0
        fi
        sleep 5
        waited=$((waited + 5))
        echo "Waiting for $wait_mount... (${waited}s/${max_wait}s)"
    done
    echo "WARNING: $wait_mount not available after ${max_wait}s"
    return 1
}

setup_persistence() {
    echo "Setting up persistent storage..."
    echo "Appdata path: $APPDATA_PATH"

    # Check if appdata mount is available
    if ! wait_for_appdata_mount; then
        echo "WARNING: Appdata mount not available. Persistence will be configured later."
        return 0
    fi

    # Early exit if symlink is already correct
    if [ -L "$CLAUDE_CONFIG_RUNTIME" ] && [ "$(readlink "$CLAUDE_CONFIG_RUNTIME")" = "$APPDATA_PATH/.claude" ]; then
        echo "Persistence already configured."
        return 0
    fi

    # Create appdata directory if it doesn't exist
    mkdir -p "$APPDATA_PATH"

    # If runtime config exists as a real directory (not symlink), migrate it
    if [ -d "$CLAUDE_CONFIG_RUNTIME" ] && [ ! -L "$CLAUDE_CONFIG_RUNTIME" ]; then
        echo "Migrating existing Claude config to appdata..."
        if [ -d "$APPDATA_PATH/.claude" ]; then
            # Merge: appdata takes precedence, but copy any missing files from runtime
            # Use -a (archive) -n (no clobber); dotglob ensures hidden files are included
            shopt -s dotglob
            cp -an "$CLAUDE_CONFIG_RUNTIME"/* "$APPDATA_PATH/.claude/"
            migrate_rc=$?
            shopt -u dotglob
            # Only delete the source once the copy has definitely succeeded.
            # This tree holds authentication, session state and agent memory;
            # the previous version discarded the copy's exit status and removed
            # it unconditionally, so a copy that failed halfway (full disk,
            # appdata share dropping out mid-migration) destroyed the only
            # remaining copy of all of it.
            if [ $migrate_rc -ne 0 ]; then
                echo "WARNING: could not merge $CLAUDE_CONFIG_RUNTIME into $APPDATA_PATH/.claude."
                echo "Nothing was deleted -- your existing config is untouched at $CLAUDE_CONFIG_RUNTIME."
                return 1
            fi
            rm -rf "$CLAUDE_CONFIG_RUNTIME"
        else
            if ! mv "$CLAUDE_CONFIG_RUNTIME" "$APPDATA_PATH/.claude"; then
                echo "WARNING: could not move $CLAUDE_CONFIG_RUNTIME to $APPDATA_PATH/.claude."
                echo "Nothing was deleted -- your existing config is untouched."
                return 1
            fi
        fi
    fi

    # Create .claude directory in appdata if needed
    mkdir -p "$APPDATA_PATH/.claude"

    # Create symlink (ln -sf handles removing existing symlink)
    ln -sf "$APPDATA_PATH/.claude" "$CLAUDE_CONFIG_RUNTIME"

    # Save auto-detected path to config so it's consistent on future boots.
    # Upsert rather than rewrite: this file also holds REMOTE_CONTROL_DIR and
    # LAST_SESSION_ID, and truncating it here would silently throw away
    # settings the user configured on the Settings page.
    if [ "$AUTO_DETECTED" = true ]; then
        mkdir -p "$(dirname "$PLUGIN_CFG")"
        touch "$PLUGIN_CFG"
        if grep -q '^APPDATA_PATH=' "$PLUGIN_CFG" 2>/dev/null; then
            sed -i "s|^APPDATA_PATH=.*|APPDATA_PATH=\"$APPDATA_PATH\"|" "$PLUGIN_CFG"
        else
            echo "APPDATA_PATH=\"$APPDATA_PATH\"" >> "$PLUGIN_CFG"
        fi
        echo "Saved appdata path to config."
    fi

    echo "Persistence configured: $CLAUDE_CONFIG_RUNTIME -> $APPDATA_PATH/.claude"
}

setup_claude_json() {
    # /root/.claude.json is a separate config file on tmpfs, lost on reboot.
    # Persist it by symlinking to appdata.
    local src="/root/.claude.json"
    local dest="$APPDATA_PATH/.claude.json"

    # If real file exists (not symlink), move it to appdata
    if [ -f "$src" ] && [ ! -L "$src" ]; then
        mv "$src" "$dest"
    fi

    # Create symlink if appdata copy exists
    if [ -f "$dest" ] && [ ! -L "$src" ]; then
        ln -sf "$dest" "$src"
        echo "Linked .claude.json to appdata."
    fi
}

# Main

# A plugin update deploys the new files but does not re-run this script: the
# post-install block only calls it the first time, when it adds the go-file
# entry. That left /usr/local/bin/claude stale until the next reboot. This
# entry point exists so the post-install block can refresh the launcher on
# every install and update; it is cheap and idempotent.
if [ "$1" = "launcher" ]; then
    if ensure_symlink; then
        exit 0
    fi
    echo "WARNING: Claude Code binary not found yet; the launcher will be installed on the next boot."
    exit 0
fi

# Set up persistence first so the native installer writes into appdata
# (the installer writes to ~/.claude/local/ which follows our symlink)
setup_persistence
setup_claude_json

if ! install_claude_code; then
    echo "WARNING: Failed to install Claude Code"
    echo "You can retry manually: /usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh"
    echo "Or install manually: curl -fsSL https://claude.ai/install.sh | bash"
fi

echo ""
if command -v claude &> /dev/null; then
    echo "=== Installation Complete ==="
    echo "Run 'claude' to start using Claude Code."
    echo "Your authentication will persist in: $APPDATA_PATH"
else
    echo "=== Installation Incomplete ==="
    echo "Claude Code is not yet available."
    echo "Check /var/log/claude-code-install.log for details."
    echo ""
    echo "Troubleshooting:"
    echo "  1. Make sure you have network connectivity"
    echo "  2. Try running: /usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh"
fi
]]>
</INLINE>
</FILE>

<!-- Thin wrapper so the Settings page's "Reinstall" button also writes to the
     live log (install-claude.sh itself is untouched to keep it close to
     upstream) -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/reinstall-and-log.sh" Mode="0755">
<SHA256>bebae0b077321bc2f106e5f91aad56d1ba79975b4c0c717b27b2f3a1dff3a5e2</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash
LOGFILE="/var/log/claude-code-install.log"
echo "=== Manual Reinstall $(date) ===" >> "$LOGFILE"
/usr/local/emhttp/plugins/claude-code/scripts/install-claude.sh 2>&1 | tee -a "$LOGFILE"
]]>
</INLINE>
</FILE>

<!-- Update: install-claude.sh's own install_claude_code() is a no-op once
     `claude` already works (it just confirms the version and returns), so
     it can never pick up a newer Claude Code release. `claude update` is
     the CLI's own built-in updater, but it only rewrites the live binary at
     ~/.local/bin/claude, it never touches the appdata cache that
     restore_cached_binary() restores from on every boot, so without
     re-caching here, any update would silently be reverted on next reboot. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/update-claude.sh" Mode="0755">
<SHA256>2e3b744466a078c4a0f005270394a5e6049817f43566fff8ebb3e1dd9b6c8de4</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash
# See install-claude.sh: the web UI runs this with a minimal PATH that has
# neither /usr/local/bin nor /root/.local/bin on it, so without this the
# "is claude installed" check below always failed and this script exited
# immediately telling you to reinstall a Claude Code that was already there.
export PATH="/usr/local/bin:/root/.local/bin:$PATH"

LOGFILE="/var/log/claude-code-install.log"
exec > >(tee -a "$LOGFILE") 2>&1
echo "=== Manual Update $(date) ==="

PLUGIN_CFG="/boot/config/plugins/claude-code/claude-code.cfg"
[ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"

RUNTIME_BIN="/root/.local/bin/claude"
VERSIONS_DIR="/root/.local/share/claude/versions"

# Copying over a binary that some process is currently executing fails with
# "Text file busy" (ETXTBSY), and on this plugin that is the normal case, not
# the exception: Remote Control keeps a claude running around the clock. A
# plain cp therefore failed every time while the script still announced the
# new version, so "Applied version 2.1.259" and "Claude Code: 2.1.251" sat on
# the same screen and every update after the first silently did nothing.
#
# Writing next to the target and renaming over it works regardless: rename
# only replaces the directory entry, and a process already running keeps the
# old inode until it restarts. The exit status decides what gets reported.
apply_binary() {
    local src="$1" dst="$2" tmp="$2.new.$$"
    if ! cp "$src" "$tmp" 2>&1; then rm -f "$tmp"; return 1; fi
    if ! chmod +x "$tmp"; then rm -f "$tmp"; return 1; fi
    if ! mv -f "$tmp" "$dst"; then rm -f "$tmp"; return 1; fi
    return 0
}

if ! command -v claude &> /dev/null; then
    echo "Claude Code is not installed yet -- use Reinstall first."
    exit 1
fi

before=$(claude --version 2>/dev/null)
echo "Current version: $before"
echo "Checking for updates..."
claude update

# `claude update` downloads new versions into $VERSIONS_DIR, but only
# repoints RUNTIME_BIN at the newest one if RUNTIME_BIN is a symlink it
# manages itself. On this plugin RUNTIME_BIN is a plain copy (restored
# from the appdata cache on every boot), so the CLI leaves it untouched
# and prints a warning -- the newly downloaded version has to be applied
# by hand below, or "Now running" would still show the old version.
applied=""
if [ -d "$VERSIONS_DIR" ]; then
    latest=$(ls -1 "$VERSIONS_DIR" 2>/dev/null | sort -V | tail -1)
    if [ -n "$latest" ] && [ -x "$VERSIONS_DIR/$latest" ]; then
        if cmp -s "$VERSIONS_DIR/$latest" "$RUNTIME_BIN"; then
            echo "Version $latest is already the one installed at $RUNTIME_BIN."
            applied="$latest"
        elif apply_binary "$VERSIONS_DIR/$latest" "$RUNTIME_BIN"; then
            echo "Applied version $latest to $RUNTIME_BIN."
            applied="$latest"
        else
            echo "ERROR: could not write $RUNTIME_BIN, so version $latest was NOT applied."
            echo "       The version below is still the old one. Try again, and if it keeps"
            echo "       failing check that /root has free space and that no other update is"
            echo "       running at the same time."
        fi
    fi
fi

now=$("$RUNTIME_BIN" --version 2>/dev/null)
echo "Now running: $now"

# Say it plainly when the version on disk is not the one just downloaded,
# instead of leaving the reader to compare two numbers several lines apart.
if [ -n "$applied" ] && [ -n "$now" ] && [ "${now%% *}" != "$applied" ]; then
    echo "WARNING: expected $applied but $RUNTIME_BIN reports ${now%% *}."
fi

if [ -n "$APPDATA_PATH" ]; then
    if [ -x "$RUNTIME_BIN" ]; then
        mkdir -p "$APPDATA_PATH/bin"
        if apply_binary "$RUNTIME_BIN" "$APPDATA_PATH/bin/claude"; then
            echo "Cached the updated binary to $APPDATA_PATH/bin -- this version will survive the next reboot."
        else
            echo "WARNING: could not cache the binary to $APPDATA_PATH/bin -- the update applies now but may be reverted on the next reboot."
        fi
    fi
else
    echo "WARNING: APPDATA_PATH not set, could not cache the update -- it may be reverted on next reboot."
fi

# A rename leaves processes that were already running on the old inode: they
# keep the previous version until they are restarted. Remote Control is the
# one that matters here, since it normally runs for weeks.
if [ -n "$now" ] && [ "$before" != "$now" ] && pgrep -f "claude remote-control" > /dev/null 2>&1; then
    echo
    echo "NOTE: Remote Control is running and is still using $before."
    echo "      Stop it and start it again from the Remote Control tab to move it to ${now%% *}."
fi
]]>
</INLINE>
</FILE>

<!-- Remote Control: a supervised background "claude remote-control" process,
     started/stopped only from the Settings page (never at boot, see
     README). It always resumes the same session in its working directory
     via the continue flag, falling back to a fresh session the first time
     (before any session exists, continue errors with "No recent session
     found"). Auto-respawns on transient exits (e.g. the ~10min
     network-outage timeout documented by Anthropic) as long as it hasn't
     been explicitly stopped.

     A session can also be archived on the claude.ai side (this is a user
     action there, not something Claude does on its own); continuing an
     archived session fails immediately every time with "Session failed:
     Process exited with error", never "No recent session found", so the
     original fallback never caught it and the supervisor retried the same
     dead session forever. After a few consecutive failures like that, this
     script now gives up on the old session, starts a brand new one, and
     leaves a clearly-marked ARCHIVED_SESSION_FALLBACK line in the log that
     the Settings page surfaces as a notice.

     Every session id this script ever connects to (fresh or resumed) is
     appended to session-history.log on the persistent flash share, so a
     previous session can be picked again later even after a newer one has
     taken over as "most recent"; see the connect subcommand and the
     Settings page's Session ID field. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/remote-control.sh" Mode="0755">
<SHA256>c405c4df1e952110e8d00b762b8073e6af17cdc483e734b9f981d745acac824e</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash

PLUGIN_CFG="/boot/config/plugins/claude-code/claude-code.cfg"
HISTORY_FILE="/boot/config/plugins/claude-code/session-history.log"
PROFILES_SCRIPT="/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh"
ARCHIVED_FAIL_THRESHOLD=3
SESSION_POLL_SECONDS=3

# Which account this invocation is for, and everything that follows from it.
#
# Each account gets its own supervisor, pid file, log and session history, so
# two accounts can be connected at the same time. The main account deliberately
# keeps the original unsuffixed paths: an upgrade must not orphan the
# supervisor that is already running under the old names.
set_profile() {
    PROFILE="${1:-}"
    MULTI_ACCOUNT="no"
    ACTIVE_PROFILE="default"
    REMOTE_CONTROL_DIR=""
    [ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"
    [ "$MULTI_ACCOUNT" = "yes" ] || PROFILE="default"
    [ -z "$PROFILE" ] && PROFILE="${ACTIVE_PROFILE:-default}"

    if [ "$PROFILE" = "default" ]; then
        SUFFIX=""
        NAME_PREFIX="unraid"
    else
        SUFFIX="-$PROFILE"
        # The account ends up in the child's own command line, which is the only
        # way to stop one account's bridge without stopping the others: every
        # "claude remote-control" otherwise looks identical.
        NAME_PREFIX="unraid-$PROFILE"
    fi

    # Where this account's own session id is remembered.
    if [ "$PROFILE" = "default" ]; then
        SESSION_ID_KEY="LAST_SESSION_ID"
    else
        SESSION_ID_KEY="LAST_SESSION_ID_$PROFILE"
    fi

    LOGFILE="/var/log/claude-code-remote-control$SUFFIX.log"
    PIDFILE="/var/run/claude-remote-control$SUFFIX.pid"
    ENABLED_FLAG="/var/run/claude-remote-control$SUFFIX.enabled"
    PINFILE="/var/run/claude-remote-control$SUFFIX.pin"

    # The environment that selects this account, from the script that owns that
    # decision. Empty for the main account.
    PROFILE_ENV=""
    if [ "$PROFILE" != "default" ] && [ -x "$PROFILES_SCRIPT" ]; then
        PROFILE_ENV=$("$PROFILES_SCRIPT" env "$PROFILE" 2>/dev/null)
    fi
}

# Every configured account, main one first.
all_profiles() {
    MULTI_ACCOUNT="no"; PROFILES=""
    [ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"
    if [ "$MULTI_ACCOUNT" = "yes" ]; then
        echo "default $PROFILES"
    else
        echo "default"
    fi
}

# The working directory an account runs in. An account can have its own, and
# otherwise inherits the one configured for the server: a directory the user
# set is a directory the user meant, including when every account shares it.
#
# Sharing one is allowed and supported. What it costs, in the shared-memory
# mode, is that "--continue" resumes the most recent session *of a directory*
# regardless of which account started it: an account may find the other's
# session there, fail to resume it because it is not theirs, and fall through
# to a fresh session after the usual retries. Accounts with separate
# directories never go through that.
get_rc_dir() {
    local var value
    REMOTE_CONTROL_DIR=""
    [ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"
    if [ "$PROFILE" = "default" ]; then
        echo "${REMOTE_CONTROL_DIR:-/root/claude-remote-control}"
        return
    fi
    var="REMOTE_CONTROL_DIR_$PROFILE"
    value="${!var}"
    echo "${value:-${REMOTE_CONTROL_DIR:-/root/claude-remote-control-$PROFILE}}"
}

# Upserts KEY="value" into PLUGIN_CFG without touching other keys -- same
# shell-sourceable/parse_ini_file-compatible format install-claude.sh already
# writes APPDATA_PATH in. Used to remember the last "connect"-ed session id
# so the Settings page field isn't empty again after a page reload.
save_cfg_var() {
    local key="$1" value="$2"
    mkdir -p "$(dirname "$PLUGIN_CFG")"
    touch "$PLUGIN_CFG"
    if grep -q "^${key}=" "$PLUGIN_CFG" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$PLUGIN_CFG"
    else
        echo "${key}=\"${value}\"" >> "$PLUGIN_CFG"
    fi
}

get_cfg_var() {
    local key="$1" line
    [ -f "$PLUGIN_CFG" ] || return 0
    line=$(grep -m1 "^${key}=" "$PLUGIN_CFG" 2>/dev/null) || return 0
    printf '%s' "${line#*=}" | sed -e 's/^"//' -e 's/"$//'
}

# Appends one session id to the history file, skipping if it's already the
# newest entry (the same id shows up over and over while claude redraws its
# connection status line in place).
record_sid() {
    local sid="$1" rc_dir="$2"
    [ -z "$sid" ] && return
    mkdir -p "$(dirname "$HISTORY_FILE")"
    # Checked against the recent tail rather than only the last line: with an
    # account per supervisor there are several writers, so this account's own
    # last entry is not necessarily the final line any more.
    if [ ! -f "$HISTORY_FILE" ] || ! tail -20 "$HISTORY_FILE" | grep -q " $sid "; then
        # The account goes in brackets at the end: a directory can contain
        # spaces, so appending it bare would make the line ambiguous. Lines
        # written before accounts existed simply have no bracket.
        echo "$(date -Iseconds) $sid $rc_dir [$PROFILE]" >> "$HISTORY_FILE"
        # Remember it as this account's own session. That is what lets an
        # account resume its session rather than whatever happens to be the
        # most recent one in a directory it may be sharing.
        [ -n "$SESSION_ID_KEY" ] && save_cfg_var "$SESSION_ID_KEY" "$sid"
    fi
}

# Watches the log while claude is still running and records the session id as
# soon as it gets printed, rather than waiting for the process to exit.
# Without this a healthy long-lived session never reached the history file at
# all: recording only happened after the command substitution around claude
# returned, which for a session that stays connected for weeks means never.
# Reads from $1 (the log size when this attempt started) so it only ever sees
# this attempt's output, not ids from previous connections.
#
# Tied to the lifetime of the process that started it ($3): "Stop" kills the
# supervisor outright, and without this check the watcher would survive as an
# orphan, polling forever and stacking up another one on every Start.
watch_for_sessions() {
    local offset="$1" rc_dir="$2" parent="$3" sid
    while kill -0 "$parent" 2>/dev/null; do
        sleep "$SESSION_POLL_SECONDS"
        sid=$(tail -c "+$((offset + 1))" "$LOGFILE" 2>/dev/null | grep -oE 'session_[A-Za-z0-9]+' | tail -1)
        [ -n "$sid" ] && record_sid "$sid" "$rc_dir"
    done
}

# Runs one "claude remote-control" attempt with the watcher above attached,
# echoing claude's combined output so callers can still grep it for the
# archived/no-session markers. The watcher is detached from stdout so it
# can't hold the caller's command substitution open after claude exits.
run_claude() {
    local rc_dir="$1"; shift
    local offset watcher output self
    offset=$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)
    # $BASHPID, not $$: run_claude may itself be running inside a subshell, and
    # the watcher has to follow that subshell, not the top-level script. It has
    # to be captured into a variable first, too: written inline as an argument
    # to a backgrounded command, $BASHPID expands inside the new child, so the
    # watcher would end up watching itself and never notice the parent dying.
    self=$BASHPID
    watch_for_sessions "$offset" "$rc_dir" "$self" > /dev/null 2>&1 &
    watcher=$!
    if [ -n "$PROFILE_ENV" ]; then
        output=$(env "$PROFILE_ENV" claude remote-control "$@" --remote-control-session-name-prefix "$NAME_PREFIX" 2>&1 < /dev/null | tee -a "$LOGFILE")
    else
        output=$(claude remote-control "$@" --remote-control-session-name-prefix "$NAME_PREFIX" 2>&1 < /dev/null | tee -a "$LOGFILE")
    fi
    kill "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
    # Also record on exit, in case the attempt was shorter than one poll.
    record_sid "$(echo "$output" | grep -oE 'session_[A-Za-z0-9]+' | tail -1)" "$rc_dir"
    printf '%s\n' "$output"
}

run_fresh() {
    local rc_dir="$1"
    echo "=== Starting a fresh session in $rc_dir: $(date) ===" >> "$LOGFILE"
    run_claude "$rc_dir" > /dev/null
}

do_run() {
    local rc_dir output pinned_id own_id fail_count=0
    rc_dir=$(get_rc_dir)
    mkdir -p "$rc_dir"
    echo "=== Remote Control supervisor started $(date) (dir: $rc_dir) ===" >> "$LOGFILE"
    while [ -f "$ENABLED_FLAG" ]; do
        cd "$rc_dir" || break

        if [ -f "$PINFILE" ]; then
            pinned_id=$(cat "$PINFILE")
            rm -f "$PINFILE"
            echo "=== Connecting to requested session id $pinned_id: $(date) ===" >> "$LOGFILE"
            output=$(run_claude "$rc_dir" --session-id "$pinned_id")
            if echo "$output" | grep -qi "session failed: Process exited with error"; then
                echo "=== ARCHIVED_SESSION_FALLBACK: requested session $pinned_id could not be resumed (likely archived or ended) -- starting a new session instead: $(date) ===" >> "$LOGFILE"
                run_fresh "$rc_dir"
            fi
            fail_count=0
        else
            # "--continue" resumes the most recent session *of this directory*,
            # whichever account started it. With accounts sharing a directory
            # that is the wrong session: the CLI refuses to serve one that
            # another instance already holds. So an account that knows its own
            # session id asks for that one by name, and only falls back to
            # --continue when it has none yet. The main account keeps using
            # --continue, exactly as it always has.
            own_id=""
            [ "$PROFILE" != "default" ] && own_id=$(get_cfg_var "$SESSION_ID_KEY")
            if [ -n "$own_id" ]; then
                output=$(run_claude "$rc_dir" --session-id "$own_id")
            else
                output=$(run_claude "$rc_dir" --continue)
            fi

            # Another instance is already serving that session. There is no
            # ambiguity here and no point retrying: this account needs a session
            # of its own, now. Without this the supervisor retried the same
            # taken session every 5 seconds forever -- the same shape of
            # infinite loop the archived-session check was added to prevent.
            if echo "$output" | grep -q "already being served by another"; then
                echo "=== The session in $rc_dir is already held by another instance${own_id:+ (}${own_id}${own_id:+)} -- starting a new session for account '$PROFILE': $(date) ===" >> "$LOGFILE"
                fail_count=0
                [ -n "$own_id" ] && save_cfg_var "$SESSION_ID_KEY" ""
                run_fresh "$rc_dir"
            elif echo "$output" | grep -q "No recent session found"; then
                fail_count=0
                run_fresh "$rc_dir"
            # Matched case-insensitively on purpose: claude emits this as
            # "Bridge session failed: Process exited with error", so the
            # capitalised "Session failed" this used to look for never once
            # matched, and the archived-session fallback never fired at all.
            elif echo "$output" | grep -qi "session failed: Process exited with error"; then
                fail_count=$((fail_count + 1))
                if [ "$fail_count" -ge "$ARCHIVED_FAIL_THRESHOLD" ]; then
                    echo "=== ARCHIVED_SESSION_FALLBACK: previous session in $rc_dir failed to resume $fail_count times in a row (likely archived or ended) -- starting a new session instead: $(date) ===" >> "$LOGFILE"
                    fail_count=0
                    # Forget the dead id too, or the next start would ask for it
                    # by name and fail its way here all over again.
                    [ -n "$own_id" ] && save_cfg_var "$SESSION_ID_KEY" ""
                    run_fresh "$rc_dir"
                fi
            else
                fail_count=0
            fi
        fi

        [ -f "$ENABLED_FLAG" ] || break
        echo "=== Remote Control exited, restarting in 5s: $(date) ===" >> "$LOGFILE"
        sleep 5
    done
    echo "=== Remote Control supervisor stopped $(date) ===" >> "$LOGFILE"
    rm -f "$PIDFILE"
}

stop_running() {
    rm -f "$ENABLED_FLAG"
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    # Scoped to this account. A bare "pkill -f 'claude remote-control'" would
    # take every account's bridge down with it, because their command lines are
    # identical apart from the session name prefix -- which is exactly why the
    # prefix carries the account. Anchored at the end so "unraid" does not also
    # match "unraid-work".
    pkill -f "remote-control.sh _run $PROFILE\$" 2>/dev/null
    pkill -f "remote-control-session-name-prefix $NAME_PREFIX\$" 2>/dev/null
}

# Subcommands take the account as their first argument. Without one they act on
# the account in use, except "stop", which with no account stops every one of
# them: the uninstall path calls it that way and must leave nothing running.
CMD="${1:-}"
SLUG=""
case "${2:-}" in
    session_*) ;;              # "connect <sid>": a session id, not an account
    "")        ;;
    *) SLUG="$2" ;;
esac
if [ -n "$SLUG" ]; then SID="${3:-}"; else SID="${2:-}"; fi

set_profile "$SLUG"

case "$CMD" in
    start)
        if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
            echo "Remote Control is already running for account '$PROFILE'."
            exit 0
        fi
        rm -f "$PINFILE"
        touch "$ENABLED_FLAG"
        nohup "$0" _run "$PROFILE" > /dev/null 2>&1 &
        echo $! > "$PIDFILE"
        echo "Remote Control starting for account '$PROFILE' in directory: $(get_rc_dir)"
        echo "Use 'View live logs' below for the session URL / QR code."
        ;;
    _run)
        do_run
        ;;
    connect)
        if ! echo "$SID" | grep -qE '^session_[A-Za-z0-9]+$'; then
            echo "Usage: $0 connect [account] <session_id> (expected a session_... id)"
            exit 1
        fi
        save_cfg_var "$SESSION_ID_KEY" "$SID"
        stop_running
        echo "$SID" > "$PINFILE"
        touch "$ENABLED_FLAG"
        nohup "$0" _run "$PROFILE" > /dev/null 2>&1 &
        echo $! > "$PIDFILE"
        echo "Remote Control connecting account '$PROFILE' to session: $SID"
        echo "Use 'View live logs' below for status."
        ;;
    stop)
        if [ -n "$SLUG" ]; then
            stop_running
            rm -f "$PINFILE"
            echo "=== Remote Control stopped by user $(date) ===" >> "$LOGFILE"
            echo "Remote Control stopped for account '$PROFILE'."
        else
            # No account named: stop all of them, so an uninstall or a blanket
            # "stop" cannot leave another account's supervisor respawning.
            for p in $(all_profiles); do
                set_profile "$p"
                stop_running
                rm -f "$PINFILE"
                [ -f "$LOGFILE" ] && echo "=== Remote Control stopped by user $(date) ===" >> "$LOGFILE"
            done
            echo "Remote Control stopped."
        fi
        ;;
    status)
        if [ -f "$PIDFILE" ] && [ -d "/proc/$(cat "$PIDFILE")" ]; then
            echo "running"
        else
            echo "stopped"
        fi
        ;;
    *)
        echo "Usage: $0 {start [account]|stop [account]|status [account]|connect [account] <session_id>}"
        exit 1
        ;;
esac
]]>
</INLINE>
</FILE>

<!-- Claude account profiles: several logins on one server, either sharing
     the agent memory and settings or fully isolated. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh" Mode="0755">
<SHA256>cace0e5630e7ac8c6841b0e483e625792d6e5b406f059aec03abff77bc055ba3</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash

# Claude account profiles.
#
# Lets this server hold several Claude logins at once. Which files a profile
# owns depends on the mode the user picked:
#
#   shared   -- only the credentials move (CLAUDE_SECURESTORAGE_CONFIG_DIR).
#               Agent memory, settings, MCP servers and session history stay in
#               the one config home every account shares. This is the default,
#               because losing the memory you already built up is the surprise
#               nobody wants from "add a second account".
#   isolated -- the whole config home moves (CLAUDE_CONFIG_DIR): every account
#               gets its own memory, settings, MCPs and history.
#
# Both modes run several accounts at the same time; they differ only in what is
# shared. Neither ever moves or rewrites the existing login: the "default"
# profile is the config that was already there, addressed by setting no
# variables at all, and extra profiles are new directories beside it.
#
# Deliberately NOT done here:
#   * No symlink repointing. An earlier design switched /root/.claude between
#     profiles; environment variables do the same job without ever putting the
#     live login behind a link that could be left dangling.
#   * No copying of .credentials.json between profiles. Each claude process
#     refreshes its own file in place, so there is no moment where a freshly
#     rotated refresh token can be lost.

export PATH="/usr/local/bin:/root/.local/bin:$PATH"

PLUGIN_CFG="/boot/config/plugins/claude-code/claude-code.cfg"
RC_SCRIPT="/usr/local/emhttp/plugins/claude-code/scripts/remote-control.sh"

# Slugs become part of shell variable names (PROFILE_LABEL_<slug>) in a config
# file that is both sourced by these scripts and read by parse_ini_file, so a
# hyphen or a space would produce a file that breaks on the next source.
SLUG_RE='^[a-z][a-z0-9_]{0,23}$'

load_cfg() {
    MULTI_ACCOUNT="no"
    ACCOUNT_MODE="shared"
    ACTIVE_PROFILE="default"
    PROFILES=""
    APPDATA_PATH=""
    [ -f "$PLUGIN_CFG" ] && source "$PLUGIN_CFG"
    [ -z "$APPDATA_PATH" ] && APPDATA_PATH="/mnt/user/appdata/claude-code"
    [ -z "$ACTIVE_PROFILE" ] && ACTIVE_PROFILE="default"
    [ -z "$ACCOUNT_MODE" ] && ACCOUNT_MODE="shared"
    PROFILES_DIR="$APPDATA_PATH/profiles"
}

# Upsert KEY="value" without touching other keys -- the same format and the same
# care as remote-control.sh's helper, because this file also holds APPDATA_PATH,
# REMOTE_CONTROL_DIR and LAST_SESSION_ID.
save_cfg_var() {
    local key="$1" value="$2"
    mkdir -p "$(dirname "$PLUGIN_CFG")"
    touch "$PLUGIN_CFG"
    if grep -q "^${key}=" "$PLUGIN_CFG" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$PLUGIN_CFG"
    else
        echo "${key}=\"${value}\"" >> "$PLUGIN_CFG"
    fi
}

del_cfg_var() {
    [ -f "$PLUGIN_CFG" ] && sed -i "/^${1}=/d" "$PLUGIN_CFG"
}

# Every profile except "default" lives in its own directory. "default" is the
# pre-existing config and is addressed by setting no variables at all, which is
# what keeps this feature from touching a working login.
profile_dir() {
    [ "$1" = "default" ] && return 1
    echo "$PROFILES_DIR/$1"
}

# The environment that selects a profile, as KEY=VALUE lines. Empty for the
# default profile. Callers export these; the launcher wrapper only applies them
# when the variable is not already set, so an explicit choice always wins.
profile_env() {
    local slug="$1" dir
    dir=$(profile_dir "$slug") || return 0
    case "$ACCOUNT_MODE" in
        isolated) echo "CLAUDE_CONFIG_DIR=$dir" ;;
        *)        echo "CLAUDE_SECURESTORAGE_CONFIG_DIR=$dir" ;;
    esac
}

profile_exists() {
    [ "$1" = "default" ] && return 0
    local p
    for p in $PROFILES; do [ "$p" = "$1" ] && return 0; done
    return 1
}

profile_label() {
    local var="PROFILE_LABEL_$1" label
    label="${!var}"
    [ -z "$label" ] && label="$1"
    echo "$label"
}

# Ask the CLI who a profile is logged in as. This is the authoritative answer --
# .claude.json's cached oauthAccount is shared between profiles in shared mode
# and so cannot identify them -- but it costs a process spawn, so the result is
# cached in the config and only refreshed on demand or after a login.
refresh_profile() {
    local slug="$1" envline status email plan logged
    if ! command -v claude >/dev/null 2>&1; then
        return 1
    fi
    # One quoted argument, not an unquoted expansion: an appdata path with a
    # space in it would otherwise split into two broken arguments.
    envline=$(profile_env "$slug")
    if [ -n "$envline" ]; then
        status=$(env "$envline" claude auth status --json 2>/dev/null)
    else
        status=$(claude auth status --json 2>/dev/null)
    fi
    [ -z "$status" ] && return 1
    # Parsed with grep rather than a JSON tool: Unraid ships no jq, and this
    # only ever reads three flat string fields.
    logged=$(echo "$status" | grep -o '"loggedIn"[[:space:]]*:[[:space:]]*true')
    email=$(echo "$status" | sed -n 's/.*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    plan=$(echo "$status" | sed -n 's/.*"subscriptionType"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ -n "$logged" ]; then
        save_cfg_var "PROFILE_EMAIL_$slug" "$email"
        save_cfg_var "PROFILE_PLAN_$slug" "$plan"
    else
        save_cfg_var "PROFILE_EMAIL_$slug" ""
        save_cfg_var "PROFILE_PLAN_$slug" ""
    fi
    return 0
}

rc_running() {
    local pidfile="/var/run/claude-remote-control.pid"
    [ -f "$pidfile" ] || return 1
    local pid
    pid=$(cat "$pidfile" 2>/dev/null)
    [ -n "$pid" ] && [ -d "/proc/$pid" ]
}

cmd_list() {
    # TSV so the Settings page can render it without a JSON parser:
    # slug <TAB> label <TAB> active <TAB> email <TAB> plan <TAB> logged_in
    local slug email_var plan_var email plan active logged
    for slug in default $PROFILES; do
        email_var="PROFILE_EMAIL_$slug"; email="${!email_var}"
        plan_var="PROFILE_PLAN_$slug";   plan="${!plan_var}"
        active="no"; [ "$slug" = "$ACTIVE_PROFILE" ] && active="yes"
        logged="no"; [ -n "$email" ] && logged="yes"
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$slug" "$(profile_label "$slug")" "$active" "$email" "$plan" "$logged"
    done
}

# Turns whatever the user typed into a usable directory name. Asking people to
# invent a lowercase identifier is friction for no benefit: the name they type
# is kept verbatim as the label, and this derives the slug behind it.
slugify() {
    local s="$1" out
    # Fold accented letters explicitly rather than relying on iconv's
    # //TRANSLIT: on Unraid it is a no-op, so "Cuenta de Rubén" came out as
    # cuenta_de_rub_n. These are byte-exact UTF-8 sequences, so the
    # substitution does not depend on the locale being set.
    # Fold accented letters one full sequence at a time. Not a bracket
    # expression and not iconv's //TRANSLIT: iconv is a no-op here, and in a
    # non-UTF-8 locale sed matches brackets byte by byte, so [áàä] also
    # matches the lead byte every accented letter shares and "Rubén" came
    # out as "Rubaen". Uppercase is handled by the lowercasing below.
    out=$(printf '%s' "$s" | sed -e 's/á/a/g' -e 's/à/a/g' -e 's/ä/a/g' -e 's/â/a/g' -e 's/ã/a/g' -e 's/å/a/g' -e 's/é/e/g' -e 's/è/e/g' -e 's/ë/e/g' -e 's/ê/e/g' -e 's/í/i/g' -e 's/ì/i/g' -e 's/ï/i/g' -e 's/î/i/g' -e 's/ó/o/g' -e 's/ò/o/g' -e 's/ö/o/g' -e 's/ô/o/g' -e 's/õ/o/g' -e 's/ú/u/g' -e 's/ù/u/g' -e 's/ü/u/g' -e 's/û/u/g' -e 's/ñ/n/g' -e 's/ç/c/g')
    [ -z "$out" ] && out="$s"
    out=$(printf '%s' "$out" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\+/_/g' -e 's/^_*//' -e 's/_*$//')
    out=$(printf '%s' "$out" | cut -c1-24)
    # Must start with a letter: the slug becomes part of a shell variable name.
    case "$out" in
        [a-z]*) ;;
        *) out="cuenta${out:+_$out}" ;;
    esac
    printf '%s' "$out"
}

cmd_add() {
    local label="$1" slug="$2" dir base n
    if [ -z "$label" ]; then
        echo "Give the account a name."
        return 1
    fi
    # An explicit slug is only for scripting; the web UI passes the name alone.
    [ -z "$slug" ] && slug=$(slugify "$label")
    if ! echo "$slug" | grep -qE "$SLUG_RE"; then
        echo "Could not turn '$label' into a folder name. Try a name with some letters or digits in it."
        return 1
    fi
    # Two accounts called "Trabajo" and "trabajo!" would collide; number them.
    if profile_exists "$slug"; then
        base=$(printf '%s' "$slug" | cut -c1-21)
        n=2
        while profile_exists "${base}_$n" && [ "$n" -lt 50 ]; do n=$((n + 1)); done
        slug="${base}_$n"
    fi
    if profile_exists "$slug"; then
        echo "An account named '$slug' already exists."
        return 1
    fi
    dir=$(profile_dir "$slug")
    if ! mkdir -p "$dir"; then
        echo "Could not create $dir -- is the array started?"
        return 1
    fi
    # Credentials live here; keep them off other users' eyes even on a share
    # that is otherwise readable.
    chmod 700 "$dir"
    save_cfg_var "PROFILES" "$(echo $PROFILES $slug | xargs)"
    save_cfg_var "PROFILE_LABEL_$slug" "$label"
    echo "Account '$label' created. Use Sign in to authenticate it."
}

cmd_remove() {
    local slug="$1" purge="$2" dir new p
    if [ "$slug" = "default" ]; then
        echo "The main account cannot be removed."
        return 1
    fi
    if ! profile_exists "$slug"; then
        echo "No such account: $slug"
        return 1
    fi
    if [ "$slug" = "$ACTIVE_PROFILE" ]; then
        echo "'$slug' is the account in use. Switch to another one first."
        return 1
    fi
    new=""
    for p in $PROFILES; do [ "$p" = "$slug" ] || new="$new $p"; done
    save_cfg_var "PROFILES" "$(echo $new | xargs)"
    del_cfg_var "PROFILE_LABEL_$slug"
    del_cfg_var "PROFILE_EMAIL_$slug"
    del_cfg_var "PROFILE_PLAN_$slug"
    dir=$(profile_dir "$slug")
    if [ "$purge" = "purge" ]; then
        # Only ever inside the profiles directory, and only a path just built
        # from a validated slug.
        case "$dir" in
            "$PROFILES_DIR"/*)
                # In isolated mode this directory is the account's entire config
                # home, and that includes projects/<dir>/memory -- the agent's
                # persistent memory, plus every session transcript. Removing an
                # account deletes its credentials and settings and NOTHING else:
                # memory is never destroyed by a delete on this page. Whoever
                # touches this next: keep it that way.
                find "$dir" -mindepth 1 -maxdepth 1 ! -name projects -exec rm -rf {} + 2>/dev/null
                if [ -d "$dir/projects" ]; then
                    echo "Account '$slug' removed. Its credentials and settings were deleted."
                    echo "Its memory and session history were kept, untouched, at $dir/projects."
                else
                    rmdir "$dir" 2>/dev/null
                    echo "Account '$slug' removed and its data deleted."
                fi
                ;;
            *) echo "Refusing to delete an unexpected path: $dir"; return 1 ;;
        esac
    else
        echo "Account '$slug' removed from the list. Its data is still at $dir."
    fi
}

cmd_activate() {
    local slug="$1" was_running=no
    if ! profile_exists "$slug"; then
        echo "No such account: $slug"
        return 1
    fi
    if [ "$slug" = "$ACTIVE_PROFILE" ]; then
        echo "'$slug' is already the account in use."
        return 0
    fi
    # A live bridge keeps its credentials open; let it finish on the account it
    # started with rather than swapping underneath it.
    if rc_running; then
        was_running=yes
        echo "Stopping Remote Control..."
        [ -x "$RC_SCRIPT" ] && "$RC_SCRIPT" stop >/dev/null 2>&1
    fi
    save_cfg_var "ACTIVE_PROFILE" "$slug"
    echo "Now using account: $(profile_label "$slug")"
    if [ "$was_running" = yes ]; then
        echo "Starting Remote Control again..."
        [ -x "$RC_SCRIPT" ] && "$RC_SCRIPT" start >/dev/null 2>&1
    fi
    echo "Interactive terminals already open keep the previous account until you"
    echo "start a new one."
}

cmd_status() {
    echo "Multi-account: $MULTI_ACCOUNT"
    echo "Mode: $ACCOUNT_MODE"
    echo "Active account: $ACTIVE_PROFILE"
    echo "Accounts: default $PROFILES"
    local e
    e=$(profile_env "$ACTIVE_PROFILE")
    [ -n "$e" ] && echo "Environment: $e" || echo "Environment: (none -- the original config)"
}

load_cfg

case "$1" in
    list)     cmd_list ;;
    add)      cmd_add "$2" "$3" ;;   # name [slug]
    remove)   cmd_remove "$2" "$3" ;;
    activate) cmd_activate "$2" ;;
    refresh)
        if [ -n "$2" ]; then
            refresh_profile "$2"
        else
            for p in default $PROFILES; do refresh_profile "$p"; done
        fi
        ;;
    env)
        # Used by the launcher wrapper and by remote-control.sh. Defaults to the
        # active profile so callers do not have to read the config themselves.
        profile_env "${2:-$ACTIVE_PROFILE}"
        ;;
    status)   cmd_status ;;
    *)
        echo "Usage: $0 {list|add <name> [slug]|remove <slug> [purge]|activate <slug>|refresh [slug]|env [slug]|status}"
        exit 1
        ;;
esac
]]>
</INLINE>
</FILE>

<!-- Installed as /usr/local/bin/claude so the account chosen in the web UI
     also applies to "claude" typed in a terminal. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/scripts/claude-launcher.sh" Mode="0755">
<SHA256>df1436b7fbe51a12d1f9ae23875c702dbc7420078af3d2d5822e076cf85e08a8</SHA256>
<INLINE>
<![CDATA[
#!/bin/bash

# Claude Code launcher -- installed as /usr/local/bin/claude by the claude-code
# plugin. LAUNCHER_GENERATION=1
#
# This used to be a plain symlink to the real binary. It became a wrapper so
# that the account selected on the Settings page also applies to "claude" typed
# in a terminal, without moving or relinking anybody's configuration.
#
# It fails open on purpose: if the config is missing, unreadable or nonsense,
# it hands over to the real binary unchanged. A broken account selection is an
# inconvenience; a "claude" that no longer starts is a broken server.
#
# Variables already present in the environment are never overwritten, so an
# explicit "CLAUDE_CONFIG_DIR=... claude" (or a profile chosen by
# remote-control.sh) always wins over the configured default.

REAL="/root/.local/bin/claude"
[ -x "$REAL" ] || REAL="/root/.claude/local/bin/claude"

CFG="/boot/config/plugins/claude-code/claude-code.cfg"
if [ -r "$CFG" ]; then
    MULTI_ACCOUNT="no"
    ACCOUNT_MODE="shared"
    ACTIVE_PROFILE="default"
    APPDATA_PATH=""
    . "$CFG" 2>/dev/null

    if [ "$MULTI_ACCOUNT" = "yes" ] && [ -n "$ACTIVE_PROFILE" ] && [ "$ACTIVE_PROFILE" != "default" ]; then
        [ -z "$APPDATA_PATH" ] && APPDATA_PATH="/mnt/user/appdata/claude-code"
        PROFILE_DIR="$APPDATA_PATH/profiles/$ACTIVE_PROFILE"
        # A profile whose directory is gone (array not started yet, appdata
        # moved) must not send claude looking for credentials that aren't
        # there -- fall through to the original config instead.
        if [ -d "$PROFILE_DIR" ]; then
            if [ "$ACCOUNT_MODE" = "isolated" ]; then
                # Tested for being *set*, not for being non-empty: the CLI
                # treats an empty CLAUDE_CONFIG_DIR/SECURESTORAGE var as a
                # deliberate "use the home directory", so an empty value is a
                # caller's choice to respect, not a gap to fill.
                [ -z "${CLAUDE_CONFIG_DIR+set}" ] && export CLAUDE_CONFIG_DIR="$PROFILE_DIR"
            else
                [ -z "${CLAUDE_SECURESTORAGE_CONFIG_DIR+set}" ] && export CLAUDE_SECURESTORAGE_CONFIG_DIR="$PROFILE_DIR"
            fi
        fi
    fi
fi

exec "$REAL" "$@"
]]>
</INLINE>
</FILE>

<!-- Live CPU/RAM stats endpoint, polled by the Settings page -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/include/claude-stats.php" Mode="0644">
<SHA256>9c53eb776ce1a74ad697fba73cd26db78a5bd1aaece75486b383e7e3944f563a</SHA256>
<INLINE>
<![CDATA[
<?php
// Live CPU and RAM usage of the Claude Code processes running on this server,
// as JSON, for the Settings page to poll.
//
// CPU is a real between-polls delta computed from /proc/<pid>/stat, not ps's
// pcpu: pcpu is an average over the whole process lifetime, so for a session
// that has been connected for weeks it barely moves and is useless as a live
// reading. The previous sample is cached in /var/tmp so each request can diff
// against it. Takes no input at all, so there is no parameter to sanitise.

header('Content-Type: application/json');
header('Cache-Control: no-store');

$sample_file = '/var/tmp/claude-code-stats-sample.json';
$clk = (int)(trim(shell_exec('getconf CLK_TCK')) ?: 100);
if ($clk <= 0) $clk = 100;
$page_kb = (int)(trim(shell_exec('getconf PAGESIZE')) ?: 4096) / 1024;

// Which account each process belongs to. A process selects its account through
// the environment, not through its arguments, so the answer is in
// /proc/<pid>/environ: the account whose directory a variable points at, or the
// main account when neither variable is set. This is the only per-account
// figure that needs evidence rather than a parameter, and guessing it from the
// account that happens to be selected right now would misreport every process
// started under a different one.
$profile_dirs = [];
$profiles_script = '/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh';
if (is_executable($profiles_script)) {
    foreach (explode("\n", trim((string)shell_exec(escapeshellarg($profiles_script) . ' list 2>/dev/null'))) as $line) {
        if ($line === '') continue;
        $slug = strtok($line, "\t");
        if ($slug === 'default' || $slug === false) continue;
        $env = trim((string)shell_exec(escapeshellarg($profiles_script) . ' env ' . escapeshellarg($slug) . ' 2>/dev/null'));
        if ($env === '') continue;
        $kv = explode('=', $env, 2);
        if (count($kv) === 2) $profile_dirs[$kv[1]] = $slug;
    }
}

function profile_of($dir, $profile_dirs) {
    if (!$profile_dirs) return 'default';
    $environ = @file_get_contents("$dir/environ");
    if ($environ === false) return 'default';
    foreach (explode("\0", $environ) as $pair) {
        if ($pair === '') continue;
        $kv = explode('=', $pair, 2);
        if (count($kv) !== 2) continue;
        if ($kv[0] !== 'CLAUDE_CONFIG_DIR' && $kv[0] !== 'CLAUDE_SECURESTORAGE_CONFIG_DIR') continue;
        if (isset($profile_dirs[$kv[1]])) return $profile_dirs[$kv[1]];
    }
    // Selecting nothing means the account that was always there.
    return 'default';
}

// Every live process whose executable really is "claude" -- the remote-control
// bridge, the worker it spawns, and any interactive CLI in a terminal. Matching
// on the binary name rather than the whole command line keeps unrelated
// commands that merely mention claude (greps, this plugin's own scripts) out.
$procs = [];
foreach (glob('/proc/[0-9]*') as $dir) {
    $pid = basename($dir);
    $cmdline = @file_get_contents("$dir/cmdline");
    if ($cmdline === false || $cmdline === '') continue;
    $args = explode("\0", trim($cmdline, "\0"));
    if (basename($args[0] ?? '') !== 'claude') continue;
    $stat = @file_get_contents("$dir/stat");
    if ($stat === false) continue;
    // comm (field 2) can contain spaces and parens, so parse after the last ')'
    $pos = strrpos($stat, ')');
    if ($pos === false) continue;
    $f = explode(' ', substr($stat, $pos + 2));
    // $f[0] is field 3 (state), so field N lives at index N-3
    $procs[$pid] = [
        'ticks'   => (float)($f[11] ?? 0) + (float)($f[12] ?? 0), // utime + stime
        'rss_kb'  => (float)($f[21] ?? 0) * $page_kb,
        'cmd'     => implode(' ', $args),
        'profile' => profile_of($dir, $profile_dirs),
    ];
}

$now = microtime(true);
$prev = @json_decode(@file_get_contents($sample_file), true);
$have_delta = false;
$cpu_total = 0.0;

if (is_array($prev) && isset($prev['t'], $prev['procs'])) {
    $dt = $now - (float)$prev['t'];
    // Ignore a stale sample: a tab left open for hours would otherwise average
    // the CPU over that whole gap instead of reporting current usage.
    if ($dt > 0.05 && $dt < 120) {
        $have_delta = true;
        foreach ($procs as $pid => $info) {
            if (!isset($prev['procs'][$pid])) continue;
            $d = $info['ticks'] - (float)$prev['procs'][$pid];
            if ($d <= 0) continue; // pid reuse, or no CPU burned since last poll
            $pct = ($d / $clk) / $dt * 100.0;
            $procs[$pid]['cpu_pct'] = round($pct, 1);
            $cpu_total += $pct;
        }
    }
}

$sample = ['t' => $now, 'procs' => []];
foreach ($procs as $pid => $info) $sample['procs'][$pid] = $info['ticks'];
@file_put_contents($sample_file, json_encode($sample));

$mem_total_kb = 0;
foreach (@file('/proc/meminfo') ?: [] as $line) {
    if (preg_match('/^MemTotal:\s+(\d+)/', $line, $m)) { $mem_total_kb = (int)$m[1]; break; }
}
$cores = (int)(trim(shell_exec('nproc')) ?: 1);

$rss_kb = 0.0;
$list = [];
$by_profile = [];
foreach ($procs as $pid => $info) {
    $rss_kb += $info['rss_kb'];
    $list[] = [
        'pid'     => (int)$pid,
        'cpu_pct' => $info['cpu_pct'] ?? null,
        'rss_kb'  => (int)$info['rss_kb'],
        'cmd'     => $info['cmd'],
        'profile' => $info['profile'],
    ];
    $slug = $info['profile'];
    if (!isset($by_profile[$slug])) $by_profile[$slug] = ['count' => 0, 'cpu_pct' => 0.0, 'rss_kb' => 0.0];
    $by_profile[$slug]['count']++;
    $by_profile[$slug]['cpu_pct'] += (float)($info['cpu_pct'] ?? 0);
    $by_profile[$slug]['rss_kb']  += $info['rss_kb'];
}
foreach ($by_profile as $slug => $t) {
    $by_profile[$slug]['cpu_pct'] = round($t['cpu_pct'], 1);
    $by_profile[$slug]['rss_kb']  = (int)$t['rss_kb'];
}
usort($list, function($a, $b) { return ($b['cpu_pct'] ?? -1) <=> ($a['cpu_pct'] ?? -1); });

echo json_encode([
    'count'      => count($procs),
    'have_delta' => $have_delta,
    'cpu_pct'    => round($cpu_total, 1),
    'cores'      => $cores,
    'rss_kb'     => (int)$rss_kb,
    // RSS is summed across processes, so shared pages are counted more than
    // once -- a slight overestimate, not an exact resident-set total.
    'rss_pct'    => $mem_total_kb > 0 ? round($rss_kb / $mem_total_kb * 100, 1) : null,
    'procs'      => $list,
    // Totals per account, for the dashboard when several accounts are in use.
    'by_profile' => $by_profile,
]);
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/claude-code/include/claude-usage.php" Mode="0644">
<SHA256>dff74d3b93d5735c58e040bc31a3de864c9869eb52c2660f0ecd8cfffad422a8</SHA256>
<INLINE>
<![CDATA[
<?php
// Claude.ai plan usage (5-hour window, weekly window, per-model weekly windows,
// and paid credit balance) as JSON, for the Settings page to poll.
//
// Source is https://api.anthropic.com/api/oauth/usage -- the same endpoint the
// CLI calls to render /usage. It is a metadata endpoint: it runs no inference,
// so polling it costs no tokens and is never billed.
//
// Two things this deliberately does NOT do:
//   1. It never writes .credentials.json. The access token expires every few
//      hours and the CLI refreshes it on its own; refreshing from here would
//      rotate the refresh token and could lock the user out of an otherwise
//      working login. On 401 we report "expired" and let the CLI fix it.
//   2. It never puts the token in a command line. Using PHP's curl keeps it in
//      this process's memory, where "ps" cannot read it.
//
// The endpoint is undocumented and may change without notice, so every field is
// read defensively and any failure degrades to a state string the page can
// quietly ignore. Takes no input, so there is no parameter to sanitise.

header('Content-Type: application/json');
header('Cache-Control: no-store');

// Which account to report on. With several accounts configured each one has
// its own limits, so the answer is per account and so is the cache: a single
// shared cache file would serve one account's figures for another, which is
// wrong data rather than merely stale data.
$profiles_script = '/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh';
$slug = 'default';
$requested = (string)($_GET['profile'] ?? '');
if ($requested !== '' && is_executable($profiles_script)) {
    // Checked against the accounts that exist, not just pattern-matched: this
    // value ends up in a file path.
    foreach (explode("\n", trim((string)shell_exec(escapeshellarg($profiles_script) . ' list 2>/dev/null'))) as $line) {
        if ($line !== '' && strtok($line, "\t") === $requested) { $slug = $requested; break; }
    }
}

$cache_file = "/var/tmp/claude-code-usage-cache-$slug.json";
// The last reading that actually worked, kept apart from the cache above. The
// access token expires after a few hours and only the CLI renews it, so an
// account nobody has used since the morning answers "expired" and the panel
// used to go blank exactly when it was asked what the figures were. Keeping
// the last good reading means the page can always say where the account
// stands, as long as it also says when that was measured.
$last_file  = "/var/tmp/claude-code-usage-last-$slug.json";
// Subscription details. They come from a different endpoint and change once a
// month at most, so they get their own long cache and are kept even when a
// later lookup fails.
$prof_file  = "/var/tmp/claude-code-profile-$slug.json";
$cache_ttl  = 60;     // successful lookups
$fail_ttl   = 30;     // failures, so a broken token doesn't hammer the API
$prof_ttl   = 21600;  // 6 h

function write_json_file($file, $payload) {
    // Write via a temp file in the same directory so a concurrent poll never
    // reads a half-written file.
    $tmp = $file . '.' . getmypid();
    if (@file_put_contents($tmp, json_encode($payload)) !== false) {
        @chmod($tmp, 0600);
        @rename($tmp, $file);
    } else {
        @unlink($tmp);
    }
}

function read_json_file($file) {
    if (!is_readable($file)) return null;
    $data = json_decode((string)@file_get_contents($file), true);
    return is_array($data) ? $data : null;
}

function respond($payload, $cache_file, $ttl, $last_file = null, $prof_file = null) {
    $payload['fetched_at'] = time();

    if (($payload['state'] ?? '') === 'ok') {
        if ($last_file !== null && !empty($payload['windows'])) {
            write_json_file($last_file, [
                'windows'     => $payload['windows'],
                'spend'       => $payload['spend'] ?? null,
                'measured_at' => time(),
            ]);
        }
    } elseif ($last_file !== null) {
        // Nothing to report right now: fall back to the last reading that
        // worked and mark it as what it is, so the page can show the figures
        // with the time they were taken instead of an empty line.
        $prev = read_json_file($last_file);
        if ($prev && !empty($prev['windows'])) {
            $payload['windows']     = $prev['windows'];
            $payload['spend']       = $prev['spend'] ?? null;
            $payload['measured_at'] = (int)($prev['measured_at'] ?? 0);
            $payload['stale']       = true;
        }
    }

    // Subscription details survive a failed usage lookup: they were true the
    // last time anyone could ask, and they do not move by the hour.
    if ($prof_file !== null && !isset($payload['subscription'])) {
        $prof = read_json_file($prof_file);
        if ($prof && !empty($prof['subscription'])) $payload['subscription'] = $prof['subscription'];
    }

    $json = json_encode($payload);
    write_json_file($cache_file, $payload);
    echo $json;
    exit;
}

// Next monthly billing anniversary of a subscription that started at $start_ts.
// The API says when the subscription began and whether it is active, but not
// when it renews, so this is derived: the same day of the following month,
// clamped to that month's length for a subscription started on a 29th-31st.
// The page labels it as an estimate for exactly this reason.
function next_monthly_anniversary($start_ts, $now) {
    $day  = (int)date('j', $start_ts);
    $hour = (int)date('G', $start_ts);
    $min  = (int)date('i', $start_ts);
    $sec  = (int)date('s', $start_ts);
    $y = (int)date('Y', $now);
    $m = (int)date('n', $now);
    for ($k = 0; $k < 24; $k++) {
        $mm = $m + $k;
        $yy = $y + intdiv($mm - 1, 12);
        $mo = (($mm - 1) % 12) + 1;
        $days_in_month = (int)date('t', mktime(0, 0, 0, $mo, 1, $yy));
        $cand = mktime($hour, $min, $sec, $mo, min($day, $days_in_month), $yy);
        if ($cand > $now) return $cand;
    }
    return null;
}

// Serve from cache while it is fresh.
if (is_readable($cache_file)) {
    $cached = json_decode((string)@file_get_contents($cache_file), true);
    if (is_array($cached) && isset($cached['fetched_at'])) {
        $age = time() - (int)$cached['fetched_at'];
        $ttl = (($cached['state'] ?? '') === 'ok') ? $cache_ttl : $fail_ttl;
        if ($age >= 0 && $age < $ttl) {
            $cached['age'] = $age;
            echo json_encode($cached);
            exit;
        }
    }
}

// Locate the credentials. /root/.claude is normally a symlink into appdata, but
// read the configured path too in case the symlink has not been set up yet.
$cfg_file = '/boot/config/plugins/claude-code/claude-code.cfg';
$appdata = '';
if (is_readable($cfg_file)) {
    $cfg = @parse_ini_file($cfg_file);
    if (!empty($cfg['APPDATA_PATH'])) $appdata = rtrim($cfg['APPDATA_PATH'], '/');
}
if ($slug === 'default') {
    // The main account is the login that was already here. /root/.claude is
    // normally a symlink into appdata, but read the configured path too in case
    // the symlink has not been set up yet.
    $cred_paths = ['/root/.claude/.credentials.json'];
    if ($appdata !== '') $cred_paths[] = "$appdata/.claude/.credentials.json";
} else {
    // Every extra account keeps its credentials in its own profile directory,
    // in both the shared and the isolated mode.
    $cred_paths = $appdata !== '' ? ["$appdata/profiles/$slug/.credentials.json"] : [];
}

$token = null;
$expires_at = null;
foreach ($cred_paths as $path) {
    if (!is_readable($path)) continue;
    $creds = json_decode((string)@file_get_contents($path), true);
    $oauth = $creds['claudeAiOauth'] ?? null;
    if (is_array($oauth) && !empty($oauth['accessToken'])) {
        $token = $oauth['accessToken'];
        // expiresAt is milliseconds since the epoch.
        $expires_at = isset($oauth['expiresAt']) ? (int)($oauth['expiresAt'] / 1000) : null;
        break;
    }
}

if ($token === null) {
    // Either not logged in, or logged in with an API key rather than a Claude
    // subscription -- neither has plan windows to report.
    respond(['state' => 'no-auth'], $cache_file, $fail_ttl, $last_file, $prof_file);
}

if ($expires_at !== null && $expires_at <= time()) {
    // Don't spend a request we know will 401.
    respond(['state' => 'expired'], $cache_file, $fail_ttl, $last_file, $prof_file);
}

// Both endpoints below are read with the same headers; neither runs inference.
function oauth_get($url, $token) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 8,
        CURLOPT_CONNECTTIMEOUT => 5,
        CURLOPT_HTTPHEADER     => [
            'Authorization: Bearer ' . $token,
            'Content-Type: application/json',
            'anthropic-beta: oauth-2025-04-20',
        ],
    ]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    return [$code, $body];
}

[$http, $body] = oauth_get('https://api.anthropic.com/api/oauth/usage', $token);

if ($http === 401 || $http === 403) {
    respond(['state' => 'expired'], $cache_file, $fail_ttl, $last_file, $prof_file);
}
if ($http !== 200 || !is_string($body)) {
    respond(['state' => 'error', 'http' => $http], $cache_file, $fail_ttl, $last_file, $prof_file);
}

$data = json_decode($body, true);
if (!is_array($data)) {
    respond(['state' => 'error', 'http' => $http], $cache_file, $fail_ttl, $last_file, $prof_file);
}

// Turn an ISO-8601 reset timestamp into epoch seconds; null stays null.
function reset_epoch($value) {
    if (!is_string($value) || $value === '') return null;
    $ts = strtotime($value);
    return $ts === false ? null : $ts;
}

$windows = [];

// The two windows every subscription has. Show them even at 0%, so the page
// always states where you stand rather than going blank on a quiet day.
foreach (['five_hour', 'seven_day'] as $key) {
    $w = $data[$key] ?? null;
    if (!is_array($w) || !isset($w['utilization']) || !is_numeric($w['utilization'])) continue;
    $windows[] = [
        'key'       => $key,
        'label'     => null,
        'percent'   => (float)$w['utilization'],
        'resets_at' => reset_epoch($w['resets_at'] ?? null),
    ];
}

// Per-model weekly windows. Read them from the normalised "limits" array rather
// than the seven_day_<model> keys: that array carries the model's display name,
// so a plan that gains a new per-model bucket shows up here with no code change.
// On plans without per-model limits this loop simply adds nothing.
foreach (($data['limits'] ?? []) as $limit) {
    if (!is_array($limit)) continue;
    if (($limit['kind'] ?? '') !== 'weekly_scoped') continue;
    $name = $limit['scope']['model']['display_name'] ?? null;
    if (!is_string($name) || $name === '') continue;
    if (!isset($limit['percent']) || !is_numeric($limit['percent'])) continue;
    $windows[] = [
        'key'       => 'model',
        'label'     => $name,
        'percent'   => (float)$limit['percent'],
        'resets_at' => reset_epoch($limit['resets_at'] ?? null),
    ];
}

// Credit balance and spend, reported only when the account actually has extra
// usage turned on. An account that has never enabled it returns zeros and nulls
// here, and showing "0.00 $ spent" would just be noise.
$spend = null;
$s = $data['spend'] ?? null;
$extra = $data['extra_usage'] ?? null;
$extra_on = is_array($extra) && ($extra['is_enabled'] ?? false) === true;
if (is_array($s) && (($s['enabled'] ?? false) === true || $extra_on)) {
    $exponent = (int)($s['used']['exponent'] ?? 2);
    $to_units = function ($minor) use ($exponent) {
        return is_numeric($minor) ? ((float)$minor) / pow(10, $exponent) : null;
    };
    $spend = [
        'used'     => $to_units($s['used']['amount_minor'] ?? null),
        'limit'    => $to_units($s['limit']['amount_minor'] ?? null),
        'balance'  => $to_units($s['balance']['amount_minor'] ?? null),
        'currency' => $s['used']['currency'] ?? 'USD',
        'percent'  => isset($s['percent']) && is_numeric($s['percent']) ? (float)$s['percent'] : null,
    ];
}

// Subscription: status and, derived from when it started, when it renews next.
// A separate endpoint (/api/oauth/profile, the one the CLI reads for account
// details) and a much longer cache, since none of this moves during a day.
$subscription = null;
$prof_cached = read_json_file($prof_file);
if ($prof_cached && isset($prof_cached['fetched_at']) &&
    (time() - (int)$prof_cached['fetched_at']) < $prof_ttl && !empty($prof_cached['subscription'])) {
    $subscription = $prof_cached['subscription'];
} else {
    [$phttp, $pbody] = oauth_get('https://api.anthropic.com/api/oauth/profile', $token);
    $pdata = ($phttp === 200 && is_string($pbody)) ? json_decode($pbody, true) : null;
    if (is_array($pdata) && is_array($pdata['organization'] ?? null)) {
        $org = $pdata['organization'];
        $started = isset($org['subscription_created_at']) ? strtotime((string)$org['subscription_created_at']) : false;
        $subscription = [
            'status'   => (string)($org['subscription_status'] ?? ''),
            'plan'     => (string)($org['organization_type'] ?? ''),
            'billing'  => (string)($org['billing_type'] ?? ''),
            'since'    => $started === false ? null : $started,
            // Only a stripe subscription renews on a billing cycle; a seat in a
            // team or an enterprise agreement does not, so no date is guessed
            // for those.
            'renews'   => ($started !== false && ($org['billing_type'] ?? '') === 'stripe_subscription')
                            ? next_monthly_anniversary($started, time()) : null,
            'trial_ends' => isset($org['claude_code_trial_ends_at']) && $org['claude_code_trial_ends_at']
                            ? (strtotime((string)$org['claude_code_trial_ends_at']) ?: null) : null,
        ];
        write_json_file($prof_file, ['fetched_at' => time(), 'subscription' => $subscription]);
    } elseif ($prof_cached && !empty($prof_cached['subscription'])) {
        // The lookup failed; what was true last time still beats nothing.
        $subscription = $prof_cached['subscription'];
    }
}
unset($token);

respond([
    'state'        => 'ok',
    'windows'      => $windows,
    'spend'        => $spend,
    'subscription' => $subscription,
], $cache_file, $cache_ttl, $last_file, $prof_file);
]]>
</INLINE>
</FILE>

<!-- Shared preamble and styling for the tabs. Every tab requires this once,
     so the state it computes is worked out a single time per request. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/include/common.php" Mode="0644">
<SHA256>bdae3b462efb3bc8b6d5065f1deea84fe42f80417d6e92d4e6c0fa34423786b3</SHA256>
<INLINE>
<![CDATA[
<?php
// Shared preamble for the Claude Code settings tabs.
//
// Unraid renders every tab of a Tabs="true" page in one request, evaluating
// each .page file into the same scope, so this runs once through require_once
// and all four tabs read the state it computes. Everything defined here is
// therefore visible in every tab: keep the names distinctive, and do not
// redefine them there.


$plugin_dir = "/boot/config/plugins/claude-code";
$cfg_file = "$plugin_dir/claude-code.cfg";

// Show Spanish when Unraid's webGUI language is set to any Spanish variant
// (dynamix.cfg's locale=, e.g. "es_ES"), English otherwise. No separate
// language files — just picks between the two strings passed to t().
$dynamixCfg = @parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg') ?: [];
$isSpanish = stripos($dynamixCfg['locale'] ?? 'en_US', 'es_') === 0;
function t($en, $es) {
    global $isSpanish;
    return $isSpanish ? $es : $en;
}

$cfg = file_exists($cfg_file) ? parse_ini_file($cfg_file) : [];
$appdata_path = $cfg['APPDATA_PATH'] ?? '';

// Fallback if config not yet populated (install script saves the auto-detected path)
if (empty($appdata_path)) {
    $appdata_path = '/mnt/user/appdata/claude-code';
}
$auth_dir = "$appdata_path/.claude";
$has_auth = is_dir($auth_dir);

// Which account is logged in. Claude Code caches the profile in .claude.json,
// so this is a plain local read: no API call, nothing that can expire, and it
// still works while the array is spun down. A server authenticated with an API
// key instead of a Claude.ai login has no oauthAccount, and the bar falls back
// to just saying the auth is configured.
$account_email = '';
$account_plan  = '';
$claude_json = "$appdata_path/.claude.json";
if (is_readable($claude_json)) {
    $acct = json_decode((string)@file_get_contents($claude_json), true)['oauthAccount'] ?? null;
    if (is_array($acct)) {
        if (!empty($acct['emailAddress'])) {
            $account_email = (string)$acct['emailAddress'];
        }
        // organizationType reads "claude_pro", "claude_max" and so on; show the
        // tier on its own rather than the raw identifier.
        if (!empty($acct['organizationType'])) {
            $account_plan = ucwords(str_replace('_', ' ', preg_replace('/^claude_/', '', (string)$acct['organizationType'])));
        }
    }
}

// Claude accounts. Off by default, in which case none of this is shown and
// the plugin behaves exactly as it did before the feature existed.
$multi_account = ($cfg['MULTI_ACCOUNT'] ?? 'no') === 'yes';
$account_mode  = ($cfg['ACCOUNT_MODE'] ?? 'shared') === 'isolated' ? 'isolated' : 'shared';
$active_profile = $cfg['ACTIVE_PROFILE'] ?? 'default';
$extra_profiles = trim((string)($cfg['PROFILES'] ?? ''));
$profiles_script = '/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh';
// The mode decides where each account's files live, so it can only be chosen
// while there is nothing to move.
$mode_locked = $extra_profiles !== '';

$profiles = [];
if ($multi_account && is_executable($profiles_script)) {
    // Tab separated, one account per line: slug, label, active, email, plan,
    // logged in. Parsed rather than recomputed here so the script stays the
    // single source of truth for what an account is.
    foreach (explode("\n", trim((string)shell_exec(escapeshellarg($profiles_script) . ' list 2>/dev/null'))) as $line) {
        if ($line === '') continue;
        $f = explode("\t", $line);
        if (count($f) < 6) continue;
        $profiles[] = [
            'slug'   => $f[0],
            'label'  => $f[1],
            'active' => $f[2] === 'yes',
            'email'  => $f[3],
            'plan'   => $f[4],
            'logged' => $f[5] === 'yes',
        ];
    }
}

// The main account has no label of its own -- it is the config that was
// already there -- so give it a readable name rather than showing the internal
// slug in the interface.
foreach ($profiles as $i => $prow) {
    if ($prow['slug'] === 'default' && $prow['label'] === 'default') {
        $profiles[$i]['label'] = t('Main account', 'Cuenta principal');
    }
}

// The accounts the usage panel reports on. Always at least one entry: the plan
// figures belong to an account even when there is only one of them, and saying
// which is the point of the panel.
$usage_accounts = [];
foreach ($profiles as $prow) {
    $usage_accounts[] = [
        'slug'  => $prow['slug'],
        'label' => $prow['email'] !== '' ? $prow['email'] : $prow['label'],
    ];
}
if (!$usage_accounts) {
    $usage_accounts[] = [
        'slug'  => 'default',
        'label' => $account_email !== '' ? $account_email : t('Main account', 'Cuenta principal'),
    ];
}

// Which row is the account in use, if any. Computed here rather than inside the
// status bar below because $has_auth depends on it: with several accounts the
// signed-in one need not be the original config directory.
$active_row = null;
foreach ($profiles as $prow) {
    if ($prow['active']) { $active_row = $prow; break; }
}

// Check if array is started (check for actual mount, not just directory)
$array_started = trim(shell_exec("mountpoint -q /mnt/user 2>/dev/null && echo yes || echo no")) === "yes";

// Check if claude is installed
$claude_installed = trim(shell_exec("which claude 2>/dev/null")) !== "";
$claude_version = $claude_installed ? htmlspecialchars(trim(shell_exec("claude --version 2>/dev/null")) ?: "Unknown") : "";

// Check symlink status
$symlink_target = is_link("/root/.claude") ? readlink("/root/.claude") : null;
$symlink_ok = $symlink_target === "$appdata_path/.claude";

// Install/startup log (written by rc.claude-code on every boot)
$log_name = "claude-code-install.log";
$log_exists = file_exists("/var/log/$log_name");

// Remote Control status/config
// Remote Control state, per account. Each account runs its own supervisor with
// its own pid file, log and session, so every one of these is read per account
// rather than once for the server.
//
// The main account keeps the original unsuffixed paths on purpose: an upgrade
// must not orphan a supervisor that is already running under the old names.
$rc_accounts = [];
foreach (($profiles ?: [['slug' => 'default', 'label' => t('Main account', 'Cuenta principal'), 'email' => '']]) as $prow) {
    $slug = $prow['slug'];
    $suffix = $slug === 'default' ? '' : "-$slug";

    // An account can have its own working directory and otherwise inherits the
    // one configured for the server, so a directory the user set is honoured
    // for every account rather than quietly replaced by a per-account default.
    $dir_key = $slug === 'default' ? 'REMOTE_CONTROL_DIR' : "REMOTE_CONTROL_DIR_$slug";
    $dir_cfg = $cfg[$dir_key] ?? '';
    $dir_main = $cfg['REMOTE_CONTROL_DIR'] ?? '';
    $dir_default = $slug === 'default'
        ? '/root/claude-remote-control'
        : ($dir_main !== '' ? $dir_main : "/root/claude-remote-control-$slug");

    $pidfile = "/var/run/claude-remote-control$suffix.pid";
    $running = false;
    if (file_exists($pidfile)) {
        $pid = trim((string)@file_get_contents($pidfile));
        $running = $pid !== '' && file_exists("/proc/$pid");
    }

    $log_name = "claude-code-remote-control$suffix.log";
    $log_exists = file_exists("/var/log/$log_name");
    $session_url = '';
    $archived = '';
    if ($log_exists) {
        $tail = shell_exec("tail -n 300 /var/log/" . escapeshellarg($log_name) . " 2>/dev/null");
        if ($tail && preg_match_all('#https://claude\.ai/code[^\s]*#', $tail, $m) && !empty($m[0])) {
            $session_url = end($m[0]);
        }
        // A freshly created session announces itself with an environment URL
        // rather than a session one, which opens the right place but does not
        // say which session it is. When the account's own id is known, link
        // straight at it: same destination, and it matches what the row says.
        $known_sid = $cfg[$slug === 'default' ? 'LAST_SESSION_ID' : "LAST_SESSION_ID_$slug"] ?? '';
        if ($known_sid !== '' && strpos($session_url, $known_sid) === false) {
            $session_url = "https://claude.ai/code/$known_sid";
        }
        if ($tail && preg_match_all('/^=== ARCHIVED_SESSION_FALLBACK:.*$/m', $tail, $a)) {
            $archived = end($a[0]);
        }
    }

    $rc_accounts[] = [
        'slug'        => $slug,
        'label'       => $prow['label'],
        'email'       => $prow['email'] ?? '',
        'dir_cfg'     => $dir_cfg,
        'dir'         => $dir_cfg !== '' ? $dir_cfg : $dir_default,
        'dir_key'     => $dir_key,
        'dir_default' => $dir_default,
        'running'     => $running,
        'log_name'    => $log_name,
        'log_exists'  => $log_exists,
        'session_url' => $session_url,
        'archived'    => $archived,
        'last_sid'    => $cfg[$slug === 'default' ? 'LAST_SESSION_ID' : "LAST_SESSION_ID_$slug"] ?? '',
    ];
}

// The main account's values stay available under their old names: the status
// bar and the Logs section still speak about the server as a whole.
$rc_main = $rc_accounts[0];
$rc_running = $rc_main['running'];
$rc_log_name = $rc_main['log_name'];
$rc_log_exists = $rc_main['log_exists'];

// Claude names each project folder after its directory with "/" replaced by
// "-", which is ambiguous: a literal "-" inside a folder name encodes exactly
// the same way. Resolve it by testing candidate splits against the real
// filesystem, falling back to the raw key when nothing matches (the directory
// may simply not exist any more).
function claude_decode_project_dir($key) {
    $tokens = explode('-', $key);
    array_shift($tokens); // leading "" produced by the root slash
    if (!$tokens) return '/';
    $walk = function($prefix, $i) use (&$walk, $tokens) {
        if ($i >= count($tokens)) return $prefix;
        $seg = '';
        for ($j = $i; $j < count($tokens); $j++) {
            $seg = ($seg === '') ? $tokens[$j] : $seg . '-' . $tokens[$j];
            $cand = ($prefix === '/' ? '/' : "$prefix/") . $seg;
            if (!is_dir($cand)) continue;
            $found = $walk($cand, $j + 1);
            if ($found !== null) return $found;
        }
        return null;
    };
    $resolved = $walk('/', 0);
    return $resolved !== null ? $resolved : $key;
}

// Session IDs listed in the panel are merged from two sources:
//
//  1. session-history.log on the flash share, appended by remote-control.sh
//     every time it connects. Format: "<ISO8601 timestamp> <session_id> <dir>".
//  2. Claude's own bridge-pointer.json, one per project directory. This is
//     authoritative for the current session of each directory and also covers
//     sessions started by hand outside this plugin, which never touched the
//     plugin's own log and so would otherwise be invisible here.
$rc_history_file = '/boot/config/plugins/claude-code/session-history.log';
$rc_history = [];

if (file_exists($rc_history_file)) {
    foreach (array_filter(array_map('trim', file($rc_history_file))) as $rc_line) {
        // The account is written in brackets at the end, because a directory can
        // contain spaces. Lines written before accounts existed have none, and
        // still parse: they belong to the main account.
        if (preg_match('/^(\S+)\s+(session_\S+)\s+(.*?)(?:\s+\[([a-z0-9_]+)\])?$/', $rc_line, $rc_m)) {
            // Later lines are newer, so a repeated id keeps its latest entry.
            $rc_history[$rc_m[2]] = [
                'time'      => $rc_m[1],
                'ts'        => strtotime($rc_m[1]) ?: 0,
                'dir'       => $rc_m[3],
                'dir_known' => true, // logged verbatim, no decoding needed
                'live'      => false,
                'profile'   => $rc_m[4] ?? 'default',
            ];
        }
    }
}

foreach (glob("$appdata_path/.claude/projects/*/bridge-pointer.json") ?: [] as $bp_file) {
    $bp = @json_decode(@file_get_contents($bp_file), true);
    if (!is_array($bp) || empty($bp['sessionId'])) continue;
    $bp_sid = $bp['sessionId'];
    $bp_ts = @filemtime($bp_file) ?: 0;
    // The pid recorded here only still belongs to this session if it is alive
    // *and* is actually a claude process; pids get reused, especially across
    // a reboot, so an existing /proc entry alone proves nothing.
    $bp_pid = isset($bp['pid']) ? (int)$bp['pid'] : 0;
    $bp_live = false;
    if ($bp_pid > 0 && is_dir("/proc/$bp_pid")) {
        $bp_cmd = @file_get_contents("/proc/$bp_pid/cmdline");
        $bp_live = $bp_cmd !== false && strpos($bp_cmd, 'claude') !== false;
    }
    $bp_key = basename(dirname($bp_file));
    $bp_dir = claude_decode_project_dir($bp_key);
    if (!isset($rc_history[$bp_sid]) || $bp_ts >= $rc_history[$bp_sid]['ts']) {
        $rc_history[$bp_sid] = [
            'time'      => date('c', $bp_ts),
            'ts'        => $bp_ts,
            'dir'       => $bp_dir,
            // Unresolved means the directory no longer exists, so all that is
            // left is Claude's encoded folder name. Shown dimmed rather than
            // as if it were a real path.
            'dir_known' => $bp_dir !== $bp_key,
            'live'      => $bp_live,
            // Claude's own pointer files say nothing about which account owns a
            // session, so an entry only seen there is left unattributed.
            'profile'   => $rc_history[$bp_sid]['profile'] ?? '',
        ];
    } elseif ($bp_live) {
        $rc_history[$bp_sid]['live'] = true;
    }
}

uasort($rc_history, function($a, $b) { return $b['ts'] <=> $a['ts']; });
?>

<style>
.claude-status {
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
  border-radius: 4px;
  padding: 8px 14px;
  margin-bottom: 15px;
  font-size: 0.95em;
}
.claude-status b { margin-right: 3px; }
.claude-status .sep { opacity: 0.4; margin: 0 8px; }
/* Unraid's default-base.css styles span.warn and span.error as full-width
   BLOCK alerts with a coloured background, not as inline text colours. Inside
   these one-line bars that wrecks the layout: the value jumps onto its own
   line as a pink band spanning the whole box. The colour rules below are more
   specific so they won the `color` fight, which is why this looked fine until
   a span actually took one of those classes -- on a healthy server every
   value is `ok`, so the breakage stayed hidden. Neutralise the rest of the
   global rule, not just the colour. */
.claude-status .ok, .claude-status .warn, .claude-status .error,
.claude-box .ok, .claude-box .warn, .claude-box .error {
  display: inline;
  width: auto;
  background: none;
  background-color: transparent;
}
.claude-status .ok { color: #4caf50; }
.claude-status .warn { color: #ff9800; }
.claude-status .error { color: #f44336; }
.claude-box {
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 4px;
  padding: 5px 15px 12px 15px;
  margin-bottom: 15px;
}
.claude-box h4 {
  margin-top: 8px;
  margin-bottom: 4px;
}
/* Same state colours as the top status bar, for the boxes further down. */
.claude-box .ok { color: #4caf50; }
.claude-box .warn { color: #ff9800; }
.claude-box .error { color: #f44336; }
.claude-box .sep { opacity: 0.4; margin: 0 8px; }
.claude-code-block {
  background: #1e1e1e;
  color: #d4d4d4;
  padding: 8px 12px;
  border-radius: 4px;
  font-family: monospace;
  display: inline-block;
}
.claude-notice {
  border: 1px solid rgba(255,152,0,0.4);
  background: rgba(255,152,0,0.08);
  border-radius: 4px;
  padding: 6px 12px;
  margin: 8px 0;
  font-size: 0.9em;
}
.claude-history {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9em;
  margin: 6px 0;
}
.claude-history th, .claude-history td {
  text-align: left;
  padding: 3px 10px 3px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.claude-history code {
  font-size: 0.95em;
}
</style>
]]>
</INLINE>
</FILE>

<!-- Signs an account in from the browser: starts the CLI login detached,
     hands its authorisation URL to the page, feeds the pasted code back. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/include/claude-login.php" Mode="0644">
<SHA256>99781b3325d8eb05268a1e0ba2183f4bd7fd067546c6a4235c3415413fe9880d</SHA256>
<INLINE>
<![CDATA[
<?php
// Signs an account in from the browser, so nobody has to open a terminal.
//
// "claude auth login" prints an authorisation URL and then blocks reading a
// one-time code from stdin. That is scriptable: this endpoint starts the
// command detached with stdin on a FIFO, scrapes the URL out of its output for
// the page to link to, and writes the pasted code back into the FIFO. No pty
// is needed -- verified against the real CLI: with stdin held open and stdout
// redirected, it prints the URL and the prompt exactly as it does on a
// terminal, and it consumes the code from the pipe.
//
// Success is decided by asking "claude auth status" afterwards rather than by
// matching the CLI's success message, so a reworded message cannot make a
// finished login look like a failure.
//
// The pasted code is a one-time secret: it goes straight into the FIFO and is
// never written to the log or echoed back.

header('Content-Type: application/json');
header('Cache-Control: no-store');

// Scripts started by the webGUI inherit a minimal PATH that has neither place
// Claude Code is installed.
putenv('PATH=/usr/local/bin:/root/.local/bin:/bin:/sbin:/usr/bin:/usr/sbin');

$profiles_script = '/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh';

function out($payload) { echo json_encode($payload); exit; }

// The profile name reaches a shell command, so it is checked against the list
// of accounts that actually exist rather than merely pattern-matched.
$slug = (string)($_REQUEST['profile'] ?? 'default');
$known = false;
foreach (explode("\n", trim((string)shell_exec(escapeshellarg($profiles_script) . ' list 2>/dev/null'))) as $line) {
    if ($line === '') continue;
    if (strtok($line, "\t") === $slug) { $known = true; break; }
}
if (!$known) { out(['state' => 'error', 'error' => 'unknown-profile']); }

// Where this account's credentials land. The rule is the same in both modes:
// an extra account keeps them in its own profile directory, and the main
// account keeps them where they have always been.
$appdata = '/mnt/user/appdata/claude-code';
$cfg = @parse_ini_file('/boot/config/plugins/claude-code/claude-code.cfg');
if (!empty($cfg['APPDATA_PATH'])) $appdata = rtrim($cfg['APPDATA_PATH'], '/');
$creds_dir = $slug === 'default' ? "$appdata/.claude" : "$appdata/profiles/$slug";

$fifo = "/var/tmp/claude-login-$slug.fifo";
$log  = "/var/tmp/claude-login-$slug.log";

// The environment that selects this account, straight from the script that
// owns that decision, so the rule lives in exactly one place.
$env = trim((string)shell_exec(escapeshellarg($profiles_script) . ' env ' . escapeshellarg($slug) . ' 2>/dev/null'));
$env_arg = $env !== '' ? 'env ' . escapeshellarg($env) . ' ' : '';

// Which running "claude auth login" processes belong to this account. Matching
// on the command line alone cannot tell accounts apart, because every login has
// the identical argv: the account is only visible in the process environment,
// which is where the selecting variable ends up. Without this, cancelling or
// restarting one account's login would kill another account's in flight.
function login_pids($env) {
    $want = $env !== '' ? explode('=', $env, 2) : null;
    $pids = [];
    foreach (glob('/proc/[0-9]*') as $dir) {
        $cmdline = @file_get_contents("$dir/cmdline");
        if ($cmdline === false || strpos($cmdline, "auth\0login") === false) continue;
        $environ = (string)@file_get_contents("$dir/environ");
        $vars = [];
        foreach (explode("\0", $environ) as $pair) {
            if ($pair === '') continue;
            $kv = explode('=', $pair, 2);
            if (count($kv) === 2) $vars[$kv[0]] = $kv[1];
        }
        $has = isset($vars['CLAUDE_CONFIG_DIR']) || isset($vars['CLAUDE_SECURESTORAGE_CONFIG_DIR']);
        if ($want === null) {
            // The main account is the one selecting nothing at all.
            if (!$has) $pids[] = basename($dir);
        } elseif (($vars[$want[0]] ?? null) === $want[1]) {
            $pids[] = basename($dir);
        }
    }
    return $pids;
}

function kill_login($env) {
    foreach (login_pids($env) as $pid) {
        @posix_kill((int)$pid, 15);
    }
}

function logged_in($slug, $profiles_script, $env_arg) {
    $status = (string)shell_exec($env_arg . 'claude auth status --json 2>/dev/null');
    return strpos($status, '"loggedIn": true') !== false || strpos($status, '"loggedIn":true') !== false;
}

$action = (string)($_REQUEST['action'] ?? 'poll');

if ($action === 'start') {
    // A previous attempt for this account may still be waiting on its FIFO.
    kill_login($env);
    @unlink($fifo);
    @unlink($log);
    $cmd = 'mkfifo -m 600 ' . escapeshellarg($fifo)
         . ' && touch ' . escapeshellarg($log) . ' && chmod 600 ' . escapeshellarg($log)
         // Opening a FIFO for reading blocks until a writer appears, so a
         // writer is parked on it for the life of the attempt. It also puts a
         // ceiling on how long a forgotten half-finished login can sit around.
         . ' && ( sleep 900 > ' . escapeshellarg($fifo) . ' & )'
         . ' && ( setsid ' . $env_arg . 'claude auth login --claudeai < ' . escapeshellarg($fifo)
         . ' > ' . escapeshellarg($log) . ' 2>&1 & )';
    shell_exec($cmd . ' >/dev/null 2>&1');
    out(['state' => 'starting']);
}

if ($action === 'code') {
    $code = trim((string)($_REQUEST['code'] ?? ''));
    if ($code === '') { out(['state' => 'error', 'error' => 'empty-code']); }
    if (!file_exists($fifo)) { out(['state' => 'error', 'error' => 'not-started']); }
    // Written with a shell redirect rather than PHP's file_put_contents: a
    // FIFO with no reader would block the web request itself.
    shell_exec('printf %s\\\\n ' . escapeshellarg($code) . ' > ' . escapeshellarg($fifo) . ' 2>/dev/null &');
    out(['state' => 'submitted']);
}

if ($action === 'cancel') {
    kill_login($env);
    @unlink($fifo);
    @unlink($log);
    out(['state' => 'idle']);
}

// poll
//
// "Already signed in" is not the same as "this attempt succeeded". Signing an
// account in again -- to point it at a different Claude login -- starts from a
// state that is already logged in, so a bare check would report success
// instantly and the authorisation URL would never be shown. An attempt in
// flight is therefore only finished once the credentials file is newer than the
// FIFO that attempt created.
$attempt_started = file_exists($fifo) ? (int)@filemtime($fifo) : 0;
$cred_file = $creds_dir . '/.credentials.json';
$cred_time = is_readable($cred_file) ? (int)@filemtime($cred_file) : 0;
$finished = $attempt_started === 0 || $cred_time >= $attempt_started;

if ($finished && logged_in($slug, $profiles_script, $env_arg)) {
    // Refresh the cached name and plan for this account while we are here, so
    // the table is right the moment the page reloads.
    shell_exec(escapeshellarg($profiles_script) . ' refresh ' . escapeshellarg($slug) . ' >/dev/null 2>&1');
    @unlink($fifo);
    @unlink($log);
    out(['state' => 'done']);
}

if (!is_readable($log)) { out(['state' => 'idle']); }

$body = (string)@file_get_contents($log);
// The CLI writes a carriage return between redraws; flatten so the patterns
// below see whole lines.
$body = str_replace("\r", "\n", $body);

if (preg_match('/Login failed:([^\n]*)/', $body, $m)) {
    out(['state' => 'failed', 'error' => trim($m[1])]);
}
if (preg_match('#(https://[^\s\x1b]+/oauth/authorize\?[^\s\x1b]+)#', $body, $m)) {
    out([
        'state'   => 'url',
        'url'     => $m[1],
        'waiting' => strpos($body, 'Paste code here') !== false,
    ]);
}
out(['state' => 'starting']);
]]>
</INLINE>
</FILE>

<!-- Account actions from the Accounts tab. They report back on the page
     instead of into the progress strip, where a real error went unseen. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/include/claude-accounts.php" Mode="0644">
<SHA256>30b835ce1351b82123c2cba0bad1aeb60180c219129381ca3c89d5a2648ab0ff</SHA256>
<INLINE>
<![CDATA[
<?php
// Account actions from the Accounts tab: add, remove, switch.
//
// These used to be posted straight at profiles.sh through Unraid's #command
// form, which streams the script's output into a one-line strip at the bottom
// of the window. That strip is where a real error went to die: adding an
// account with a name the script rejected simply looked like nothing had
// happened. Going through here instead means every message the script writes
// gets shown next to the button that caused it.
//
// The script stays the single source of truth for what an account is; this only
// carries its words back to the page.

header('Content-Type: application/json');
header('Cache-Control: no-store');

putenv('PATH=/usr/local/bin:/root/.local/bin:/bin:/sbin:/usr/bin:/usr/sbin');

$script = '/usr/local/emhttp/plugins/claude-code/scripts/profiles.sh';
$action = (string)($_POST['action'] ?? '');
$name   = trim((string)($_POST['name'] ?? ''));
$slug   = trim((string)($_POST['slug'] ?? ''));

function done($ok, $message) {
    echo json_encode(['ok' => $ok, 'message' => trim($message)]);
    exit;
}

if (!is_executable($script)) { done(false, 'profiles.sh is missing'); }

// Anything that names an existing account is checked against the real list
// rather than pattern-matched: these values reach a shell command.
function known($slug, $script) {
    if ($slug === '') return false;
    foreach (explode("\n", trim((string)shell_exec(escapeshellarg($script) . ' list 2>/dev/null'))) as $line) {
        if ($line !== '' && strtok($line, "\t") === $slug) return true;
    }
    return false;
}

// exec() rather than shell_exec(): the exit status is what says whether the
// action worked, and the output is the message to show either way.
function run($cmd) {
    $lines = [];
    $rc = 0;
    exec($cmd . ' 2>&1', $lines, $rc);
    return [$rc === 0, implode("\n", $lines)];
}

switch ($action) {
    case 'add':
        // The name is free text; profiles.sh derives the folder name from it.
        if ($name === '') { done(false, ''); }
        [$ok, $out] = run(escapeshellarg($script) . ' add ' . escapeshellarg($name));
        done($ok, $out);

    case 'remove':
        if (!known($slug, $script)) { done(false, 'unknown account'); }
        $purge = ((string)($_POST['purge'] ?? '')) === 'yes' ? ' purge' : '';
        [$ok, $out] = run(escapeshellarg($script) . ' remove ' . escapeshellarg($slug) . $purge);
        done($ok, $out);

    case 'activate':
        if (!known($slug, $script)) { done(false, 'unknown account'); }
        [$ok, $out] = run(escapeshellarg($script) . ' activate ' . escapeshellarg($slug));
        done($ok, $out);

    case 'refresh':
        [$ok, $out] = run(escapeshellarg($script) . ' refresh');
        done($ok, $out);

    default:
        done(false, 'unknown action');
}
]]>
</INLINE>
</FILE>

<!-- Reads and writes Claude Code's own settings.json for the Configuration
     tab: only paths this plugin built, one backup per save, unknown keys kept. -->
<FILE Name="/usr/local/emhttp/plugins/claude-code/include/claude-config.php" Mode="0644">
<SHA256>19813d4fd381a59d1a9d74c89c8d6feb423b36844d72be87e6a600b627b92a22</SHA256>
<INLINE>
<![CDATA[
<?php
// Claude Code's own settings.json, read and written from the Configuration tab.
//
// This is not the plugin's configuration (that lives in claude-code.cfg on the
// flash share). It is the file Claude Code itself reads for the model, the
// permission rules, the environment and everything else in Anthropic's
// settings reference, which until now could only be edited by opening a
// terminal and writing JSON by hand.
//
// Three rules this file follows, in order of importance:
//
//   1. It never rewrites a key it was not asked about. The form sends only the
//      fields it manages; everything else in the file is read, kept and written
//      back untouched, so a hand-written statusLine or hooks block survives a
//      save from the browser.
//   2. It only ever writes a path built here from the plugin's own config. The
//      account name in the request selects one of those paths; it never becomes
//      part of one.
//   3. It keeps the previous version of the file next to it as settings.json.bak
//      before every write, and validates the JSON before replacing anything.

header('Content-Type: application/json');
header('Cache-Control: no-store');

$cc_cfg_file = '/boot/config/plugins/claude-code/claude-code.cfg';
$cc_cfg = is_readable($cc_cfg_file) ? (@parse_ini_file($cc_cfg_file) ?: []) : [];
$cc_appdata = rtrim((string)($cc_cfg['APPDATA_PATH'] ?? ''), '/');
if ($cc_appdata === '') $cc_appdata = '/mnt/user/appdata/claude-code';

function cc_done($ok, $message, $extra = []) {
    echo json_encode(array_merge(['ok' => $ok, 'message' => $message], $extra));
    exit;
}

// Every settings file this endpoint may touch, keyed by account.
//
// With the accounts feature off, or on in shared mode, there is exactly one:
// the accounts share a config home, so they share this file too. In isolated
// mode each account's config home is its own directory and so is its file.
function cc_targets($appdata, $cfg) {
    $targets = ['default' => "$appdata/.claude/settings.json"];
    $multi = ($cfg['MULTI_ACCOUNT'] ?? 'no') === 'yes';
    $mode  = ($cfg['ACCOUNT_MODE'] ?? 'shared') === 'isolated' ? 'isolated' : 'shared';
    if ($multi && $mode === 'isolated') {
        foreach (preg_split('/\s+/', trim((string)($cfg['PROFILES'] ?? ''))) as $slug) {
            // The slug pattern is the one profiles.sh enforces when creating an
            // account. Anything else is not an account this plugin made.
            if ($slug === '' || !preg_match('/^[a-z0-9_]{1,24}$/', $slug)) continue;
            $targets[$slug] = "$appdata/profiles/$slug/settings.json";
        }
    }
    return $targets;
}

$cc_targets = cc_targets($cc_appdata, $cc_cfg);
$cc_slug = (string)($_REQUEST['profile'] ?? 'default');
if (!isset($cc_targets[$cc_slug])) $cc_slug = 'default';
$cc_path = $cc_targets[$cc_slug];

// Reads the current file. A missing file is not an error: it simply means
// nothing has been configured yet, which is the normal state.
function cc_read($path) {
    if (!is_readable($path)) return ['exists' => false, 'raw' => '', 'settings' => []];
    $raw = (string)@file_get_contents($path);
    $parsed = json_decode($raw, true);
    return [
        'exists'   => true,
        'raw'      => $raw,
        'settings' => is_array($parsed) ? $parsed : [],
        'valid'    => is_array($parsed),
    ];
}

// PHP encodes an empty array as [], and a settings.json whose top level is an
// array is a file Claude Code refuses to load. An empty document has to stay
// an object.
function cc_encode($data) {
    if (!$data) return "{}\n";
    return json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
}

function cc_write($path, $text) {
    $dir = dirname($path);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true)) return 'could not create ' . $dir;
    // Keep the version being replaced, so a bad save is one file copy away
    // from being undone.
    if (is_file($path)) @copy($path, "$path.bak");
    $tmp = "$path.tmp." . getmypid();
    if (@file_put_contents($tmp, $text) === false) { @unlink($tmp); return "could not write $tmp"; }
    @chmod($tmp, 0644);
    // Rename rather than write in place: a reader never sees half a file, and
    // Claude Code watches this path and reloads it as soon as it changes.
    if (!@rename($tmp, $path)) { @unlink($tmp); return "could not replace $path"; }
    return '';
}

// Sets or removes one key, addressed by its dotted path exactly as the
// settings reference writes it ("permissions.defaultMode"). A null value
// removes the key, and removes the parent object with it when that leaves it
// empty -- an empty "permissions": {} is noise in a file people read.
function cc_apply(&$data, $dotted, $value) {
    $parts = explode('.', $dotted);
    $leaf = array_pop($parts);
    if (!$parts) {
        if ($value === null) unset($data[$leaf]); else $data[$leaf] = $value;
        return;
    }
    $head = array_shift($parts);
    // Removing a key from a branch that does not exist is already done.
    if ($value === null && (!isset($data[$head]) || !is_array($data[$head]))) return;
    if (!isset($data[$head]) || !is_array($data[$head])) $data[$head] = [];
    cc_apply($data[$head], implode('.', array_merge($parts, [$leaf])), $value);
    if ($value === null && !$data[$head]) unset($data[$head]);
}

$cc_action = (string)($_REQUEST['action'] ?? 'read');

if ($cc_action === 'read') {
    $cur = cc_read($cc_path);
    cc_done(true, '', [
        'profile'  => $cc_slug,
        'path'     => $cc_path,
        'exists'   => $cur['exists'],
        'valid'    => $cur['exists'] ? (bool)($cur['valid'] ?? false) : true,
        'raw'      => $cur['raw'],
        'settings' => $cur['settings'] ?: new stdClass(),
    ]);
}

if ($cc_action !== 'save' || $_SERVER['REQUEST_METHOD'] !== 'POST') {
    cc_done(false, 'unknown action');
}

$cur = cc_read($cc_path);

// Two ways in, and they are deliberately different. "values" edits the fields
// the form knows about and leaves the rest of the document alone; "raw"
// replaces the whole document, which is what the JSON editor is for.
if (isset($_POST['raw'])) {
    $text = trim((string)$_POST['raw']);
    if ($text === '') $text = '{}';
    $parsed = json_decode($text, true);
    if ($parsed === null && strtolower($text) !== 'null') {
        cc_done(false, 'Invalid JSON: ' . json_last_error_msg());
    }
    if (!is_array($parsed) || array_values($parsed) === $parsed && $parsed) {
        cc_done(false, 'The document must be a JSON object, e.g. { "model": "sonnet" }');
    }
    $data = $parsed;
} else {
    $raw_values = (string)($_POST['values'] ?? '');
    $values = json_decode($raw_values, true);
    if (!is_array($values)) cc_done(false, 'No values received');
    if ($cur['exists'] && !($cur['valid'] ?? false)) {
        // Merging into a file we could not parse would silently discard
        // whatever is in it. Refuse, and point at the editor below.
        cc_done(false, 'The current settings.json is not valid JSON, so it cannot be edited field by field. Fix it in the JSON editor first.');
    }
    $data = $cur['settings'];
    foreach ($values as $key => $value) {
        if (!is_string($key) || !preg_match('/^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)*$/', $key)) continue;
        cc_apply($data, $key, $value);
    }
}

$err = cc_write($cc_path, cc_encode($data));
if ($err !== '') cc_done(false, $err);

$after = cc_read($cc_path);
cc_done(true, 'Saved to ' . $cc_path, [
    'profile'  => $cc_slug,
    'path'     => $cc_path,
    'raw'      => $after['raw'],
    'settings' => $after['settings'] ?: new stdClass(),
]);
]]>
</INLINE>
</FILE>

